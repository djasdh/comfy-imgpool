    "rs": ("krea2_real_scene_anime_v1.safetensors", 0.6),
    "ur": ("krea2_ultrareal_v2.safetensors", 0.5),
}


def _load_lora_aliases():
    """元数据优先，内置兜底。返回 {alias: (file, strength)}。"""
    out = dict(BUILTIN_LORA_ALIASES)
    if LORA_META is None:
        return out
    try:
        for alias, (file, strength, _model) in LORA_META.alias_map().items():
            out[alias] = (file, strength)
    except Exception:
        pass
    return out


LORA_ALIASES = _load_lora_aliases()
LORA_DEFAULTS = {v[0]: v[1] for v in LORA_ALIASES.values()
                 if v[1] is not None}


def lora_groups():
    """按模型 + functional/style 分组的 LoRA 元数据，供 --list 使用。"""
    if LORA_META is None:
        return {}
    out = {}
    try:
        for model, data in LORA_META.load_all().items():
            g = {"functional": [], "style": []}
            for e in data.get("loras", []):
                g.setdefault(e.get("kind"), []).append({
                    "file": e.get("file"),
                    "description": e.get("description"),
                    "aliases": e.get("aliases") or [],
                    "default_strength": e.get("default_strength"),
                    "verified": e.get("verified", False),
                })
            out[model] = g
    except Exception:
        return {}
    return out


def lora_owner(name, model):
    """返回该 LoRA 登记在哪个模型；未登记返回 None。"""
    if LORA_META is None:
        return None
    try:
        hit = LORA_META.find(name)
    except Exception:
        return None
    return hit[0] if hit else None



# ----------------------------------------------------------------------------
# 输出 / 错误
# ----------------------------------------------------------------------------
def emit(obj):
    try:
        print(json.dumps(obj, ensure_ascii=False), flush=True)
    except BrokenPipeError:
        # 调用方提前关闭管道（例如 | head）时安静退出，不要吐 traceback
        try:
            sys.stdout.close()
        except Exception:
            pass
        os._exit(0)


def fail(code, err, message, hint=None, **extra):
    d = {"ok": False, "error": err, "message": message}
    if hint:
        d["hint"] = hint
    d.update(extra)
    emit(d)
    sys.exit(code)


def log(msg):
    print(msg, file=sys.stderr, flush=True)


def touch_activity():
    """给 imgpool 的空闲监控续命；直接调用 imggen 时也能覆盖到。"""
    try:
        os.makedirs(os.path.dirname(ACTIVITY_FILE), exist_ok=True)
        with open(ACTIVITY_FILE, "a"):
            os.utime(ACTIVITY_FILE, None)
    except Exception:
        pass


# ----------------------------------------------------------------------------
# HTTP
# ----------------------------------------------------------------------------
def http_json(path, data=None, timeout=120):
    url = BASE + path
    if data is None:
        req = urllib.request.Request(url)
    else:
        req = urllib.request.Request(
            url, data=json.dumps(data).encode(),
            headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        body = r.read()
    return json.loads(body) if body else {}


def http_post(path, data=b"{}", timeout=30):
    req = urllib.request.Request(BASE + path, data=data,
                                 headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.status


def service_up(timeout=3):
    try:
        http_json("/system_stats", timeout=timeout)
        return True
    except Exception:
        return False


def system_stats():
    return http_json("/system_stats", timeout=10)["devices"][0]


# ----------------------------------------------------------------------------
# 内存 / 服务保护
# ----------------------------------------------------------------------------
def meminfo():
    vals = {}
    with open("/proc/meminfo") as f:
        for line in f:
            k, v = line.split(":", 1)
            vals[k] = int(v.strip().split()[0]) * 1024
    avail = vals.get("MemAvailable", 0)
    swap_total = vals.get("SwapTotal", 0)
    swap_free = vals.get("SwapFree", 0)
    return avail, swap_total - swap_free


def mem_check(min_gb):
    """返回 (ok, 描述)。available 不足或 zram 已用过多都视为低内存。"""
    avail, swap_used = meminfo()
    reasons = []
    if avail < min_gb * GB:
        reasons.append(f"可用内存 {avail / GB:.1f}GB < 门槛 {min_gb:.1f}GB")
    if swap_used > 8 * GB:
        reasons.append(f"zram 已用 {swap_used / GB:.1f}GB > 8GB（有残留）")
    return (not reasons), "; ".join(reasons), avail, swap_used


def ensure_service(force=False):
    """调用 comfy-ensure.sh。返回 (started, restarted, detail)。"""
    if not os.path.exists(ENSURE):
        fail(3, "ensure_script_missing", f"找不到 {ENSURE}",
             "设置 COMFY_ROOT 或 COMFY_ENSURE，或先手动启动 ComfyUI")
    try:
        p = subprocess.run(["bash", ENSURE] + (["-f"] if force else []),
                           capture_output=True, text=True, timeout=300)
    except subprocess.TimeoutExpired:
        fail(3, "service_start_timeout", "comfy-ensure.sh 超过 300 秒未返回",
             "手动运行 bin/comfy-ensure.sh -f 检查日志 logs/comfy-2k.log")
    detail = (p.stdout or p.stderr or "").strip().splitlines()
    detail = detail[-1] if detail else ""
    if p.returncode != 0:
        fail(3, "service_start_failed",
             f"comfy-ensure.sh 退出码 {p.returncode}: {detail}",
             f"查看 {LOG} 尾部日志")
    if not service_up(timeout=20):
        fail(3, "service_not_ready", "服务启动后 20 秒仍无法访问 /system_stats",
             f"查看 {LOG}")
    return (not force), force, detail


def queue_counts():
    q = http_json("/queue", timeout=10)
    return len(q.get("queue_running") or []), len(q.get("queue_pending") or [])


def wait_queue_idle(max_wait):
    """避免和别的任务并发把内存顶爆。"""
    t0 = time.time()
    warned = False
    while time.time() - t0 < max_wait:
        run, pend = queue_counts()
        if run == 0 and pend == 0:
            return
        if not warned:
            log(f"[imggen] 队列非空（running={run} pending={pend}），等待空闲…")
            warned = True
        time.sleep(2)
    fail(6, "queue_busy", f"{max_wait}s 内队列一直非空，未提交以避免并发 OOM",
         "等当前任务结束，或加大 --queue-wait")


def acquire_lock(max_wait):
    """同一时刻只允许一个 imggen 实例，避免并发挤爆显存/内存。"""
    os.makedirs(os.path.dirname(LOCK_PATH), exist_ok=True)
    fh = open(LOCK_PATH, "w")
    t0 = time.time()
    warned = False
    while True:
        try:
            fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
            fh.write(str(os.getpid()))
            fh.flush()
            return fh
        except BlockingIOError:
            touch_activity()
            if time.time() - t0 > max_wait:
                fail(6, "lock_timeout",
                     f"{max_wait}s 内未拿到出图锁，另一个 imggen 正在跑",
                     "等它结束，或加大 --lock-wait")
            if not warned:
                log("[imggen] 另一个 imggen 正在运行，排队等待…")
                warned = True
            time.sleep(1)


# ----------------------------------------------------------------------------
# 节点图构造（API 格式）
# ----------------------------------------------------------------------------
def _add_model_chain(add, a, spec, edit_image):
    """UNET -> LoRA 链 -> RDNA2Attention，返回模型引用。"""
    add(1, "UNETLoader", {"unet_name": a.mcfg["unet"],
                          "weight_dtype": "default"})
    model_ref = ["1", 0]

    # LoRA 链（用户 LoRA 在前，MOSS edit LoRA 在后）
    loras = list(a.loras)
    if not edit_image:
        # MOSS 的 4 步预设依赖 4step 蒸馏 LoRA；多步档位不挂
        name = a.mcfg.get("default_lora")
        max_steps = a.mcfg.get("default_lora_max_steps", 8)
        if (name and spec["steps"] <= max_steps
                and all(n != name for n, _ in loras)):
            loras.insert(0, (name, 1.0))
    if edit_image:
        loras.append((a.mcfg["edit_lora"], 1.0))
    for i, (name, strength) in enumerate(loras):
        nid = 30 + i
        add(nid, "LoraLoaderModelOnly",
            {"model": model_ref, "lora_name": name, "strength_model": strength})
        model_ref = [str(nid), 0]

    add(20, "RDNA2Attention", {"model": model_ref, **a.mcfg["accel"]})
    return ["20", 0]


def build_graph(a, spec, prompt_text, edit_image):
    g = {}

    def add(nid, ctype, inputs):
        g[str(nid)] = {"class_type": ctype, "inputs": inputs}

    model_ref = _add_model_chain(add, a, spec, edit_image)

    add(3, "CLIPLoader", dict(a.mcfg["clip"]))
    add(4, "VAELoader", {"vae_name": spec.get("vae") or a.mcfg["vae"]})

    if edit_image:
        # MOSS edit：参考图 -> TextEncodeMOSSImageEdit；negative 用 ZeroOut 省一次 9B 前向
        add(40, "LoadImage", {"image": edit_image, "upload": "image"})
        add(41, "TextEncodeMOSSImageEdit", {
            "clip": ["3", 0], "prompt": prompt_text, "vae": ["4", 0],
            "edit_format": "Moss-Image-Edit",
            # Autogrow 输入必须是扁平键名，嵌套 dict 会报 required input is missing
            "images.image_0": ["40", 0],
            "image_strength": a.edit_strength,
        })
        add(42, "ConditioningZeroOut", {"conditioning": ["41", 0]})
        pos, neg = ["41", 0], ["42", 0]
    else:
        add(5, "CLIPTextEncode", {"text": prompt_text, "clip": ["3", 0]})
        if a.negative and spec["cfg"] > 1.0:
            add(6, "CLIPTextEncode", {"text": a.negative, "clip": ["3", 0]})
        else:
            add(6, "ConditioningZeroOut", {"conditioning": ["5", 0]})
        pos, neg = ["5", 0], ["6", 0]

    # 采样前卸载文本编码器（MOSS 7GB 必须；其他模型也无害）
    add(19, "ForceUnloadModels",
        {"model": model_ref, "positive": pos, "negative": neg})

    seed = a.seed
    add(7, "EmptyLatentImage",
        {"width": spec["width"], "height": spec["height"], "batch_size": 1})
    add(8, "KSampler", {
        "model": ["19", 0], "seed": seed, "steps": spec["steps"],
        "cfg": spec["cfg"], "sampler_name": spec["sampler"],
        "scheduler": spec["scheduler"], "positive": pos, "negative": neg,
        "latent_image": ["7", 0], "denoise": spec["denoise"],
    })
    last = ["8", 0]

    if spec.get("two_pass"):
        if spec.get("upscale_mode") == "pixel":
            # 像素放大链路：解码 -> SR 模型 -> 缩到目标尺寸 -> 重新编码 -> 低 denoise 精修。
            # 二次元线稿必须走这条：latent 放大靠插值撑边，低步数二采收敛不回来。
            tile = spec.get("vae_tile_size", 512)
            if spec.get("vae_tiled", True):
                add(13, "VAEDecodeTiled", {
                    "samples": last, "vae": ["4", 0],
                    "tile_size": tile, "overlap": 64,
                    "temporal_size": 64, "temporal_overlap": 8,
                })
            else:
                add(13, "VAEDecode", {"samples": last, "vae": ["4", 0]})
            add(14, "UpscaleModelLoader", {"model_name": spec["upscale_model"]})
            add(15, "ImageUpscaleWithModel", {
                "upscale_model": ["14", 0], "image": ["13", 0],
            })
            add(16, "ImageScaleBy", {
                "image": ["15", 0], "upscale_method": "lanczos",
                "scale_by": spec["scale"] / spec.get("upscale_ratio", 2.0),
            })
            if spec.get("vae_tiled", True):
                add(17, "VAEEncodeTiled", {
                    "pixels": ["16", 0], "vae": ["4", 0],
                    "tile_size": tile, "overlap": 64,
                    "temporal_size": 64, "temporal_overlap": 8,
                })
            else:
                add(17, "VAEEncode", {"pixels": ["16", 0], "vae": ["4", 0]})
            add(10, "KSampler", {
                "model": ["19", 0], "seed": seed, "steps": spec["steps2"],
                "cfg": spec["cfg"], "sampler_name": spec["sampler"],
                "scheduler": spec["scheduler"], "positive": pos, "negative": neg,
                "latent_image": ["17", 0], "denoise": spec["denoise2"],
            })
            last = ["10", 0]
        else:
            add(9, "LatentUpscaleBy", {
                "samples": last, "upscale_method": spec.get("upscale_method", "bislerp"),
                "scale_by": spec["scale"],
            })
            add(10, "KSampler", {
                "model": ["19", 0], "seed": seed, "steps": spec["steps2"],
                "cfg": spec["cfg"], "sampler_name": spec["sampler"],
                "scheduler": spec["scheduler"], "positive": pos, "negative": neg,
                "latent_image": ["9", 0], "denoise": spec["denoise2"],
            })
            last = ["10", 0]

    if spec.get("vae_tiled"):
        add(11, "VAEDecodeTiled", {
            "samples": last, "vae": ["4", 0],
            "tile_size": spec.get("vae_tile_size", 512), "overlap": 64,
            "temporal_size": 64, "temporal_overlap": 8,
        })
    else:
        add(11, "VAEDecode", {"samples": last, "vae": ["4", 0]})
    add(12, "SaveImage", {"images": ["11", 0], "filename_prefix": a.out})
    return g


def build_anypaint_graph(a, spec, prompt_text, src_name, mask_name):
    """Krea2 AnyPaint 局部编辑：mask 白=重绘，其余像素按 timestep 约束保留。

    mask 外的内容（脸、头发、背景）不参与采样，所以构图不会漂移。
    """
    g = {}

    def add(nid, ctype, inputs):
        g[str(nid)] = {"class_type": ctype, "inputs": inputs}

    add(1, "UNETLoader", {"unet_name": a.mcfg["unet"],
                          "weight_dtype": "default"})
    # AnyPaint LoRA 必须挂在最后：它把 reference latent 接进 in-context 通道。
    loras = list(a.loras) + [(a.mcfg["anypaint_lora"], 1.0)]
    model_ref = ["1", 0]
    for i, (name, strength) in enumerate(loras):
        nid = 30 + i
        add(nid, "LoraLoaderModelOnly",
            {"model": model_ref, "lora_name": name,
             "strength_model": strength})
        model_ref = [str(nid), 0]
    add(20, "RDNA2Attention", {"model": model_ref, **a.mcfg["accel"]})
    add(21, "Krea2AnyPaintModelPatch", {"model": ["20", 0],
                                        "kv_cache": True})

    add(3, "CLIPLoader", dict(a.mcfg["clip"]))
    add(4, "VAELoader", {"vae_name": spec["vae"]})

    add(50, "LoadImage", {"image": src_name, "upload": "image"})
    add(51, "LoadImageMask", {"image": mask_name, "channel": "red"})
    add(52, "Krea2AnyPaintPrepare", {
        "source": ["50", 0], "generated_mask": ["51", 0],
        "left": 0, "top": 0, "right": 0, "bottom": 0,
        "reference_max_edge": a.anypaint_ref_edge,
        "boundary_redraw_px": a.anypaint_boundary,
    })
    add(53, "Krea2AnyPaintEncode", {
        "clip": ["3", 0], "prompt": prompt_text, "vae": ["4", 0],
        "semantic_reference": ["52", 0], "known_image": ["52", 1],
        "keep_mask": ["52", 3], "vlm_reference": True,
    })
    add(54, "CLIPTextEncode", {"clip": ["3", 0], "text": a.negative or ""})
    add(55, "ForceUnloadModels",
        {"model": ["21", 0], "positive": ["53", 0], "negative": ["54", 0]})
    add(56, "KSampler", {
        "model": ["55", 0], "seed": a.seed, "steps": spec["steps"],
        "cfg": spec["cfg"], "sampler_name": spec["sampler"],
        "scheduler": spec["scheduler"], "positive": ["53", 0],
        "negative": ["54", 0], "latent_image": ["53", 1], "denoise": 1.0,
    })
    add(57, "VAEDecodeTiled", {"samples": ["56", 0], "vae": ["4", 0],
                               "tile_size": 512, "overlap": 64,
                               "temporal_size": 64, "temporal_overlap": 8})
    last = ["57", 0]
    if a.anypaint_sr:
        add(59, "UpscaleModelLoader", {"model_name": a.anypaint_sr_model})
        add(60, "ImageUpscaleWithModel", {"upscale_model": ["59", 0],
                                          "image": last})
        last = ["60", 0]
    add(58, "SaveImage", {"images": last, "filename_prefix": a.out})
    return g


def build_refine_graph(a, spec, prompt_text, src_name, mask_name,
                       sample_name, crop):
    """局部细化：crop -> 可选 SR 放大 -> mask 内低 denoise 采样 -> 羽化贴回。

    采样用内缩过的 mask，贴回用外圈羽化 mask：矩形边界落在没有重绘的
    原图像素上，避免 VAE 在裁剪边缘的亮边直接贴回。
    """
    g = {}

    def add(nid, ctype, inputs):
        g[str(nid)] = {"class_type": ctype, "inputs": inputs}

    model_ref = _add_model_chain(add, a, spec, False)

    add(3, "CLIPLoader", dict(a.mcfg["clip"]))
    add(4, "VAELoader", {"vae_name": spec["vae"]})
    add(5, "CLIPTextEncode", {"text": prompt_text, "clip": ["3", 0]})
    add(6, "ConditioningZeroOut", {"conditioning": ["5", 0]})
    add(19, "ForceUnloadModels",
        {"model": model_ref, "positive": ["5", 0], "negative": ["6", 0]})

    cx, cy, cw, ch, tw, th = crop
    add(50, "LoadImage", {"image": src_name, "upload": "image"})
    add(51, "LoadImageMask", {"image": mask_name, "channel": "red"})

    # crop 出重绘区域（含上下文）和对应的 mask
    add(52, "MaskToImage", {"mask": ["51", 0]})
    add(53, "ImageCrop", {"image": ["52", 0], "width": cw, "height": ch,
                          "x": cx, "y": cy})
    # mask 已在 prepare_refine 里用 PIL 处理过（ComfyUI 的 FeatherMask
    # 只处理图像四条边，对 crop 内部的矩形无效；ImageBlur 在大图上会 OOM）。
    # 55 = 贴回软边；74 = 采样软边（内缩一圈，避开裁剪边缘）。
    add(55, "ImageToMask", {"image": ["53", 0], "channel": "red"})
    add(71, "LoadImageMask", {"image": sample_name, "channel": "red"})
    add(72, "MaskToImage", {"mask": ["71", 0]})
    add(73, "ImageCrop", {"image": ["72", 0], "width": cw, "height": ch,
                          "x": cx, "y": cy})
    add(74, "ImageToMask", {"image": ["73", 0], "channel": "red"})
    add(56, "ImageCrop", {"image": ["50", 0], "width": cw, "height": ch,
                          "x": cx, "y": cy})

    gen = ["56", 0]
    if not a.no_refine_sr:
        add(60, "UpscaleModelLoader", {"model_name": a.refine_sr_model})
        add(61, "ImageUpscaleWithModel", {"upscale_model": ["60", 0],
                                          "image": ["56", 0]})
        gen = ["61", 0]
    add(62, "ImageScale", {"image": gen, "upscale_method": "lanczos",
                           "width": tw, "height": th, "crop": "disabled"})

    add(63, "VAEEncode", {"pixels": ["62", 0], "vae": ["4", 0]})
    # 采样用内缩过的 mask，贴回用外圈软边。
    add(64, "SetLatentNoiseMask", {"samples": ["63", 0], "mask": ["74", 0]})
    add(65, "KSampler", {"model": ["19", 0], "seed": a.seed,
                         "steps": spec["steps"], "cfg": spec["cfg"],
                         "sampler_name": spec["sampler"],
                         "scheduler": spec["scheduler"],
                         "positive": ["5", 0], "negative": ["6", 0],
                         "latent_image": ["64", 0], "denoise": spec["denoise"]})
    add(66, "VAEDecodeTiled", {"samples": ["65", 0], "vae": ["4", 0],
                               "tile_size": 512, "overlap": 64,
                               "temporal_size": 64, "temporal_overlap": 8})
    add(67, "ImageScale", {"image": ["66", 0], "upscale_method": "lanczos",
                           "width": cw, "height": ch, "crop": "disabled"})
    add(68, "ImageCompositeMasked", {"destination": ["50", 0],
                                     "source": ["67", 0], "x": cx, "y": cy,
                                     "resize_source": False, "mask": ["55", 0]})
    add(69, "SaveImage", {"images": ["68", 0], "filename_prefix": a.out})
    return g


# ----------------------------------------------------------------------------
# 入图反解（只读）：PNG 文本块 / JPEG·WebP EXIF / XMP -> imggen 配方
# ----------------------------------------------------------------------------
# 这里刻意只读取 ComfyUI 的 API 图（PNG 的 prompt 块）。UI 图（workflow
# 块）里的 widget 值可能是被连线覆盖后的残留，读它会还原出没有生效的参数。
_SECRET_KEY_RE = re.compile(
    r"(token|secret|password|passwd|api[_-]?key|authorization|credential|cookie)",
    re.I)
_TIFF_TYPE_SIZES = {1: 1, 2: 1, 3: 2, 4: 4, 5: 8, 6: 1, 7: 1, 8: 2,
                    9: 4, 10: 8, 11: 4, 12: 8}


def _redact_metadata(value, key=""):
    """去掉外部 workflow 里可能出现的凭据字段，其余原样保留。"""
    if isinstance(value, dict):
        return {k: ("***" if _SECRET_KEY_RE.search(str(k))
                    else _redact_metadata(v, k))
                for k, v in value.items()}
    if isinstance(value, list):
        return [_redact_metadata(v, key) for v in value]
    if isinstance(value, str) and _SECRET_KEY_RE.search(str(key)):
        return "***"
    return value


def _png_text_decode(data):
    """PNG 规范写 Latin-1，但 A1111 等实际会塞 UTF-8；优先 UTF-8。"""
    try:
        return data.decode("utf-8")
    except UnicodeDecodeError:
        return data.decode("latin-1")


def _png_text_chunks(data):
    out = {}
    if not data.startswith(b"\x89PNG\r\n\x1a\n"):
        return out
    pos = 8
    while pos + 8 <= len(data):
        n = struct.unpack(">I", data[pos:pos + 4])[0]
        ctype = data[pos + 4:pos + 8]
        body = data[pos + 8:pos + 8 + n]
        pos += 12 + n
        try:
            if ctype == b"tEXt":
                k, _, v = body.partition(b"\0")
                out[k.decode("latin-1")] = _png_text_decode(v)
            elif ctype == b"iTXt":
                k, _, rest = body.partition(b"\0")
                if len(rest) < 2:
                    continue
                compressed, rest = rest[0], rest[2:]
                parts = rest.split(b"\0", 2)
                if len(parts) < 3:
                    continue
                text = parts[2]
                if compressed == 1:
                    text = zlib.decompress(text)
                out[k.decode("latin-1")] = text.decode("utf-8", "replace")
            elif ctype == b"zTXt":
                k, _, rest = body.partition(b"\0")
                if rest:
                    out[k.decode("latin-1")] = _png_text_decode(
                        zlib.decompress(rest[1:]))
        except Exception:
            # 单个坏块不能毁掉整张图的其它元数据
            continue
        if ctype == b"IEND":
            break
    return out


def _png_size(data):
    if (len(data) >= 24 and data.startswith(b"\x89PNG\r\n\x1a\n")
            and data[12:16] == b"IHDR"):
        return struct.unpack(">II", data[16:24])
    return None


def _tiff_value(data, off, endian, typ, count):
    size = _TIFF_TYPE_SIZES.get(typ)
    if not size or count < 0:
        return None
    total = size * count
    if off < 0 or off + total > len(data):
        return None
    raw = data[off:off + total]
    if typ == 7:
        return raw
    if typ == 1:
        return raw if count > 1 else raw[0]
    if typ == 2:
        return raw.split(b"\0", 1)[0].decode("utf-8", "replace")
    if typ in (5, 10):
        fmt = endian + ("II" if typ == 5 else "ii")
        vals = []
        for i in range(count):
            try:
                vals.append(struct.unpack(fmt, raw[i * 8:i * 8 + 8]))
            except struct.error:
                break
        return vals
    fmt = {3: "H", 4: "I", 6: "b", 8: "h", 9: "i",
           11: "f", 12: "d"}.get(typ)
    if not fmt:
        return raw
    try:
        vals = list(struct.unpack(endian + fmt * count, raw))
    except struct.error:
        return None
    return vals[0] if count == 1 else vals


def _tiff_ifd(data, offset, endian):
    out = {}
    if offset < 0 or offset + 2 > len(data):
        return out
    count = struct.unpack(endian + "H", data[offset:offset + 2])[0]
    for i in range(count):
        p = offset + 2 + i * 12
        if p + 12 > len(data):
            break
        tag, typ, n = struct.unpack(endian + "HHI", data[p:p + 8])
        field = struct.unpack(endian + "I", data[p + 8:p + 12])[0]
        value_size = _TIFF_TYPE_SIZES.get(typ, 0) * n
        val = _tiff_value(data, p + 8 if value_size <= 4 else field,
                          endian, typ, n)
        out[tag] = val
    return out


def _parse_exif(data):
    if not data:
        return {}
    if data.startswith(b"Exif\0\0"):
        data = data[6:]
    if len(data) < 8:
        return {}
    if data[:2] == b"II":
        endian = "<"
    elif data[:2] == b"MM":
        endian = ">"
    else:
        return {}
    try:
        if struct.unpack(endian + "H", data[2:4])[0] != 42:
            return {}
        off = struct.unpack(endian + "I", data[4:8])[0]
    except struct.error:
        return {}
    ifd0 = _tiff_ifd(data, off, endian)
    out = {}
    names = {0x010E: "ImageDescription", 0x0131: "Software",
             0x9286: "UserComment", 0x9C9B: "XPTitle",
             0x9C9C: "XPComment", 0x9C9E: "XPKeywords"}
    for tag, name in names.items():
        if tag in ifd0:
            out[name] = ifd0[tag]
    exif_off = ifd0.get(0x8769)
    if isinstance(exif_off, int):
        exif = _tiff_ifd(data, exif_off, endian)
        for tag, name in names.items():
            if tag in exif:
                out[name] = exif[tag]
    return out


def _decode_exif_text(value):
    if isinstance(value, str):
        return value
    if not isinstance(value, (bytes, bytearray)):
        return ""
    raw = bytes(value)
    if raw.startswith(b"ASCII\0\0\0"):
        return raw[8:].decode("utf-8", "replace").rstrip("\0")
    if raw.startswith(b"UNICODE\0"):
        raw = raw[8:]
        if raw.startswith(b"\xff\xfe"):
            raw = raw[2:]
        try:
            return raw.decode("utf-16-le").rstrip("\0")
        except UnicodeDecodeError:
            pass
    if raw.startswith(b"JIS\0\0\0\0\0"):
        return raw[8:].decode("shift_jis", "replace").rstrip("\0")
    for enc in ("utf-8", "utf-16-le", "utf-16-be", "latin-1"):
        try:
            s = raw.decode(enc)
        except (UnicodeDecodeError, LookupError):
            continue
        if s.count("\ufffd") <= len(s) // 4:
            return s.rstrip("\0")
    return raw.decode("latin-1", "replace").rstrip("\0")


def _jpeg_metadata(data):
    out = {"xmp": []}
    size = None
    sof = set(range(0xC0, 0xD0)) - {0xC4, 0xC8, 0xCC}
    i = 2
    while i + 1 < len(data):
        if data[i] != 0xFF:
            i += 1
            continue
        while i < len(data) and data[i] == 0xFF:
            i += 1
        if i >= len(data):
            break
        marker = data[i]
        i += 1
        if marker == 0x00:
            continue
        if marker in (0xD8, 0xD9) or 0xD0 <= marker <= 0xD7:
            if marker == 0xD9:
                break
            continue
        if i + 2 > len(data):
            break
        seglen = struct.unpack(">H", data[i:i + 2])[0]
        if seglen < 2:
            break
        seg = data[i + 2:i + seglen]
        i += seglen
        if marker in sof and len(seg) >= 5:
            h, w = struct.unpack(">HH", seg[1:5])
            size = (w, h)
        elif marker == 0xE1:
            if seg.startswith(b"Exif\0\0"):
                try:
                    out.update(_parse_exif(seg))
                except Exception:
                    pass
            elif seg.startswith(b"http://ns.adobe.com/xap/1.0/\0"):
                out["xmp"].append(seg.split(b"\0", 1)[1].decode(
                    "utf-8", "replace"))
        elif marker == 0xDA:
            break
    out["size"] = size
    return out


def _webp_metadata(data):
    out = {"xmp": []}
    if len(data) < 12 or data[:4] != b"RIFF" or data[8:12] != b"WEBP":
        return out
    pos = 12
    size = None
    while pos + 8 <= len(data):
        cid = data[pos:pos + 4]
        n = struct.unpack("<I", data[pos + 4:pos + 8])[0]
        body = data[pos + 8:pos + 8 + n]
        try:
            if cid == b"VP8X" and len(body) >= 10:
                size = (1 + int.from_bytes(body[4:7], "little"),
                        1 + int.from_bytes(body[7:10], "little"))
            elif cid == b"VP8 " and len(body) >= 10:
                if body[3:6] == b"\x9d\x01\x2a":
                    size = (struct.unpack("<H", body[6:8])[0] & 0x3fff,
                            struct.unpack("<H", body[8:10])[0] & 0x3fff)
            elif cid == b"VP8L" and len(body) >= 5 and body[0] == 0x2f:
                bits = int.from_bytes(body[1:5], "little")
                size = ((bits & 0x3fff) + 1, ((bits >> 14) & 0x3fff) + 1)
            elif cid == b"EXIF":
                out.update(_parse_exif(body))
            elif cid == b"XMP ":
                out["xmp"].append(body.decode("utf-8", "replace"))
        except Exception:
            pass
        pos += 8 + n + (n & 1)
    out["size"] = size
    return out


def _read_image_metadata(path):
    with open(path, "rb") as f:
        data = f.read()
    meta = {}
    size = None
    fmt = None
    if data.startswith(b"\x89PNG\r\n\x1a\n"):
        fmt = "png"
        meta = _png_text_chunks(data)
        size = _png_size(data)
    elif data.startswith(b"\xff\xd8"):
        fmt = "jpeg"
        info = _jpeg_metadata(data)
        size = info.pop("size", None)
        xmp = info.pop("xmp", [])
        meta.update(info)
        if xmp:
            meta["_xmp"] = "\n".join(xmp)
    elif len(data) >= 12 and data[:4] == b"RIFF" and data[8:12] == b"WEBP":
        fmt = "webp"
        info = _webp_metadata(data)
        size = info.pop("size", None)
        xmp = info.pop("xmp", [])
        meta.update(info)
        if xmp:
            meta["_xmp"] = "\n".join(xmp)
    if not size:
        size = _png_size(data)
    return fmt, size, meta


def _redact_json_text(text):
    """JSON 元数据块先解析再按敏感键脱敏；非 JSON 原样保留。"""
    try:
        obj = json.loads(text)
    except (TypeError, ValueError):
        return text
    if not isinstance(obj, (dict, list)):
        return text
    return json.dumps(_redact_metadata(obj), ensure_ascii=False)


def _meta_as_strings(meta):
    out = {}
    for k, v in (meta or {}).items():
        if isinstance(v, (bytes, bytearray)):
            v = _decode_exif_text(v)
        elif isinstance(v, str):
            pass
        elif isinstance(v, (dict, list)):
            v = _redact_metadata(v, k)
        else:
            v = str(v)
        out[str(k)] = v
    return out


def parse_metadata(path):
    """只读解析图片元数据，不执行 workflow、不写任何文件。

    返回 dict，识别到格式时 ok=True 且 source 为 comfyui/a1111/novelai/
    fooocus；否则 ok=False, error='no_metadata'。原始块保留在 raw 便于回查。
    """
    p = os.path.abspath(os.path.expanduser(str(path)))
    if not os.path.isfile(p):
        return {"ok": False, "error": "file_not_found", "image": p}
    try:
        fmt, size, meta = _read_image_metadata(p)
    except OSError as e:
        return {"ok": False, "error": "image_unreadable", "image": p,
                "message": str(e)}
    except Exception as e:
        return {"ok": False, "error": "image_unreadable", "image": p,
                "message": f"{type(e).__name__}: {e}"}

    raw = _meta_as_strings(meta)
    for key in ("prompt", "workflow"):
        if key in raw:
            raw[key] = _redact_json_text(raw[key])
    # A1111/Forge 在 JPEG/WebP 里把 parameters 写进 EXIF UserComment
    # （有时写 ImageDescription），转成统一的 parameters 键。
    if "parameters" not in raw:
        for key in ("UserComment", "ImageDescription"):
            text = raw.get(key)
            if text and ("Steps:" in text or "Negative prompt:" in text):
                raw["parameters"] = text
                break
    info = {
        "ok": False,
        "image": p,
        "format": fmt,
        "size": ({"width": int(size[0]), "height": int(size[1])}
                 if size else None),
        "raw": _redact_metadata(raw),
    }

    def pick(name):
        for k, v in raw.items():
            if k.lower() == name.lower():
                return v
        return None

    workflow_raw = pick("workflow")
    if workflow_raw:
        try:
            info["workflow"] = json.loads(workflow_raw)
        except Exception:
            info["workflow_raw"] = workflow_raw

    prompt_raw = pick("prompt")
    if prompt_raw:
        try:
            graph = json.loads(prompt_raw)
        except Exception:
            graph = None
        if isinstance(graph, dict) and any(
                isinstance(v, dict) and "class_type" in v
                for v in graph.values()):
            info.update(ok=True, source="comfyui", comfy_api=graph)
            return info
        # prompt 不是 API 图时，绝不回退到 workflow 的 widget 值。

    parameters = pick("parameters")
    if parameters:
        if parameters.lstrip().startswith("{"):
            try:
                obj = json.loads(parameters)
            except Exception:
                obj = None
            if isinstance(obj, dict) and (
                    "prompt" in obj or "base_model" in obj):
                info.update(ok=True, source="fooocus", fooocus=obj)
                return info
        info.update(ok=True, source="a1111", a1111=parameters)
        return info

    comment = pick("Comment")
    if comment:
        try:
            obj = json.loads(comment)
        except Exception:
            obj = None
        if isinstance(obj, dict):
            info.update(ok=True, source="novelai", comment=obj)
            return info

    fooocus = pick("fooocus")
    if fooocus:
        try:
            obj = json.loads(fooocus)
        except Exception:
            obj = None
        if isinstance(obj, dict):
            info.update(ok=True, source="fooocus", fooocus=obj)
            return info

    xmp = pick("_xmp")
    if xmp and ("Steps:" in xmp or "Negative prompt:" in xmp):
        info.update(ok=True, source="a1111", a1111=xmp)
        return info

    info["error"] = "no_metadata"
    return info


def _graph_node(graph, nid):
    if not isinstance(graph, dict):
        return None
    node = graph.get(str(nid))
    return node if isinstance(node, dict) else None


def _link_id(value):
    if (isinstance(value, list) and len(value) >= 2
            and isinstance(value[0], (str, int))):
        return str(value[0])
    return None


def _input_links(node):
    inputs = node.get("inputs") if isinstance(node, dict) else None
    for value in (inputs or {}).values():
        nid = _link_id(value)
        if nid:
            yield nid


def _find_upstream(graph, start, classes, limit=500):
    nid = _link_id(start)
    if nid is None and isinstance(start, (str, int)):
        nid = str(start)
    if nid is None or nid not in graph:
        return None
    queue = [nid]
    seen = set()
    while queue and len(seen) < limit:
        cur = queue.pop(0)
        if cur in seen:
            continue
        seen.add(cur)
        node = _graph_node(graph, cur)
        if node is None:
            continue
        if node.get("class_type") in classes:
            return cur
        queue.extend(_input_links(node))
    return None


def _text_from_link(graph, link, seen=None):
    seen = seen if seen is not None else set()
    nid = _link_id(link)
    if not nid or nid in seen:
        return None
    seen.add(nid)
    node = _graph_node(graph, nid)
    if node is None:
        return None
    cls = node.get("class_type")
    inputs = node.get("inputs") or {}
    if cls == "ConditioningZeroOut":
        return ""
    for key in ("text", "prompt"):
        value = inputs.get(key)
        if isinstance(value, str):
            return value
        if _link_id(value):
            text = _text_from_link(graph, value, seen)
            if text is not None:
                return text
    for key in ("conditioning", "positive", "negative",
                "conditioning_1", "conditioning_2"):
        if key in inputs:
            text = _text_from_link(graph, inputs[key], seen)
            if text is not None:
                return text
    return None


def _num(value):
    if isinstance(value, bool) or value is None:
        return None
    if isinstance(value, (int, float)):
        return value
    try:
        return float(value)
    except (TypeError, ValueError):
        return None


def _norm_file(name):
    if not isinstance(name, str):
        return ""
    s = name.replace("\\", "/").split("/")[-1].strip().lower()
    for ext in (".safetensors", ".ckpt", ".pt", ".pth", ".bin"):
        if s.endswith(ext):
            s = s[:-len(ext)]
            break
    return s


def _unet_index():
    index = {}
    for model, cfg in MODELS.items():
        variants = cfg.get("variants") or {}
        if variants:
            for vname, vcfg in variants.items():
                unet = (vcfg or {}).get("unet") or cfg.get("unet")
                if unet:
                    index.setdefault(_norm_file(unet), []).append(
                        (model, vname))
        elif cfg.get("unet"):
            index.setdefault(_norm_file(cfg["unet"]), []).append(
                (model, cfg.get("default_variant") or "default"))
    return index


def _clip_index():
    index = {}
    for model, cfg in MODELS.items():
        clip = cfg.get("clip") or {}
        if clip.get("clip_name"):
            index.setdefault(_norm_file(clip["clip_name"]), []).append(
                (model, clip.get("type")))
    return index


def _known_upscale_models():
    names = set()
    for cfg in MODELS.values():
        for preset in (cfg.get("presets") or {}).values():
            if preset.get("upscale_model"):
                names.add(_norm_file(preset["upscale_model"]))
        for key in ("anypaint_sr_model", "refine_sr_model"):
            if cfg.get(key):
                names.add(_norm_file(cfg[key]))
    names.add(_norm_file("2x-AnimeSharpV2_RPLKSR_Sharp.pth"))
    return names


def _known_node_classes():
    return {
        "UNETLoader", "LoraLoader", "LoraLoaderModelOnly",
        "RDNA2Attention", "CLIPLoader", "VAELoader", "LoadImage",
        "LoadImageMask", "TextEncodeMOSSImageEdit", "ConditioningZeroOut",
        "CLIPTextEncode", "ForceUnloadModels", "EmptyLatentImage",
        "KSampler", "KSamplerAdvanced", "VAEDecode", "VAEDecodeTiled",
        "VAEEncode", "VAEEncodeTiled", "UpscaleModelLoader",
        "ImageUpscaleWithModel", "ImageScale", "ImageScaleBy",
        "LatentUpscaleBy", "SaveImage", "Krea2AnyPaintModelPatch",
        "Krea2AnyPaintPrepare", "Krea2AnyPaintEncode", "MaskToImage",
        "ImageCrop", "ImageToMask", "SetLatentNoiseMask",
        "ImageCompositeMasked", "CheckpointLoaderSimple",
    }


def _first_node(graph, classes):
    hits = []
    for nid, node in (graph or {}).items():
        if isinstance(node, dict) and node.get("class_type") in classes:
            try:
                hits.append((int(nid), nid, node))
            except (TypeError, ValueError):
                hits.append((10 ** 9, nid, node))
    hits.sort(key=lambda item: (item[0], str(item[1])))
    return hits


def _sampler_brief(node):
    inputs = (node or {}).get("inputs") or {}
    return {
        "steps": _num(inputs.get("steps")),
        "cfg": _num(inputs.get("cfg")),
        "sampler": inputs.get("sampler_name"),
        "scheduler": inputs.get("scheduler"),
        "denoise": _num(inputs.get("denoise")),
        "seed": _num(inputs.get("seed")),
    }


def _first_pass_size(graph, sampler):
    inputs = (sampler or {}).get("inputs") or {}
    latent = inputs.get("latent_image")
    nid = _link_id(latent)
    if nid:
        node = _graph_node(graph, nid)
        if node and node.get("class_type") == "EmptyLatentImage":
            li = node.get("inputs") or {}
            return _num(li.get("width")), _num(li.get("height"))
    empty = _find_upstream(graph, latent, {"EmptyLatentImage"})
    node = _graph_node(graph, empty) if empty else None
    if node:
        li = node.get("inputs") or {}
        return _num(li.get("width")), _num(li.get("height"))
    return None, None


def _upscale_info(graph, sampler):
    inputs = (sampler or {}).get("inputs") or {}
    latent = inputs.get("latent_image")
    latent_node = _graph_node(graph, _link_id(latent))
    info = {}
    if not latent_node:
        return info
    cls = latent_node.get("class_type")
    li = latent_node.get("inputs") or {}
    if cls == "LatentUpscaleBy":
        info.update(upscale_mode="latent",
                    scale_by=_num(li.get("scale_by")),
                    upscale_method=li.get("upscale_method"))
        return info

    scale_nid = _find_upstream(graph, latent, {"ImageScaleBy", "ImageScale"})
    sr_nid = _find_upstream(graph, latent, {"ImageUpscaleWithModel"})
    if not scale_nid and not sr_nid and cls in (
            "VAEEncode", "VAEEncodeTiled", "SetLatentNoiseMask"):
        pixels = li.get("pixels") or li.get("samples")
        scale_nid = _find_upstream(graph, pixels, {"ImageScaleBy", "ImageScale"})
        sr_nid = _find_upstream(graph, pixels, {"ImageUpscaleWithModel"})
    if scale_nid or sr_nid:
        info["upscale_mode"] = "pixel"
    if scale_nid:
        snode = _graph_node(graph, scale_nid) or {}
        si = snode.get("inputs") or {}
        info["scale_by"] = _num(si.get("scale_by"))
        if info["scale_by"] is None and si.get("width") and si.get("height"):
            info["target_width"] = _num(si.get("width"))
            info["target_height"] = _num(si.get("height"))
    if sr_nid:
        srnode = _graph_node(graph, sr_nid) or {}
        model_link = (srnode.get("inputs") or {}).get("upscale_model")
        loader = _find_upstream(graph, model_link, {"UpscaleModelLoader"})
        lnode = _graph_node(graph, loader) if loader else None
        if lnode:
            info["upscale"] = (lnode.get("inputs") or {}).get("model_name")
    return info


def _collect_loras(graph, sampler):
    inputs = (sampler or {}).get("inputs") or {}
    start = _link_id(inputs.get("model"))
    ids = []
    seen = set()

    def walk(nid):
        if not nid or nid in seen:
            return
        seen.add(nid)
        node = _graph_node(graph, nid)
        if node is None:
            return
        if node.get("class_type") in ("LoraLoaderModelOnly", "LoraLoader"):
            ids.append(nid)
        for child in _input_links(node):
            walk(child)

    walk(start)
    if not ids:
        ids = [item[1] for item in _first_node(
            graph, {"LoraLoaderModelOnly", "LoraLoader"})]
    ordered = []
    for nid in sorted(ids, key=lambda v: (int(v) if str(v).isdigit()
                                          else 10 ** 9, str(v))):
        node = _graph_node(graph, nid)
        if node and node not in ordered:
            ordered.append(node)
    return ordered


def _file_to_lora_name(name):
    """优先用本机别名回放；没有别名时去掉 .safetensors 后缀。"""
    if not isinstance(name, str):
        return name
    base = _norm_file(name)
    for alias, (file, _strength) in LORA_ALIASES.items():
        if _norm_file(file) == base:
            return alias
    for ext in (".safetensors", ".ckpt", ".pt", ".pth"):
        if name.lower().endswith(ext):
            return name[:-len(ext)]
    return name


def _match_local_files(unet, clip, vae):
    """unet 文件名 -> (model, variant)；unet 缺失时才用 clip 兜底。"""
    model = variant = None
    if unet:
        hits = _unet_index().get(_norm_file(unet))
        if hits:
            model, variant = hits[0]
    elif clip and clip.get("clip_name"):
        hits = _clip_index().get(_norm_file(clip["clip_name"]))
        if hits and len({h[0] for h in hits}) == 1:
            model = hits[0][0]
            variant = MODELS[model].get("default_variant")
    return model, variant


def _clip_ok(model, clip):
    if not clip:
        return True
    expected = MODELS[model].get("clip") or {}
    if _norm_file(clip.get("clip_name")) != _norm_file(
            expected.get("clip_name")):
        return False
    if clip.get("type") and expected.get("type") and \
            clip["type"] != expected["type"]:
        return False
    return True


def _known_vaes(model):
    cfg = MODELS[model]
    values = {cfg.get("vae")}
    for preset in (cfg.get("presets") or {}).values():
        if preset.get("vae"):
            values.add(preset["vae"])
    return {_norm_file(v) for v in values if v}


def _vae_ok(model, vae):
    if not vae:
        return True
    return _norm_file(vae) in _known_vaes(model)


def _comfy_recipe(graph):
    if isinstance(graph, str):
        try:
            graph = json.loads(graph)
        except ValueError:
            graph = {}
    if not isinstance(graph, dict):
        graph = {}

    samplers = _first_node(graph, {"KSampler", "KSamplerAdvanced"})
    first = second = None
    for _n, _nid, node in samplers:
        if _find_upstream(graph, (node.get("inputs") or {}).get("latent_image"),
                          {"EmptyLatentImage"}):
            first = node
            break
    if first is None and samplers:
        first = samplers[0][2]
    for _n, _nid, node in samplers:
        if node is first:
            continue
        if _find_upstream(graph, (node.get("inputs") or {}).get("latent_image"),
                          {"LatentUpscaleBy", "VAEEncode",
                           "VAEEncodeTiled", "SetLatentNoiseMask"}):
            second = node
            break
    if second is None:
        for _n, _nid, node in samplers:
            if node is not first:
                second = node
                break

    unet_nodes = _first_node(graph, {"UNETLoader", "CheckpointLoaderSimple"})
    unet = None
    if unet_nodes:
        ui = unet_nodes[0][2].get("inputs") or {}
        unet = ui.get("unet_name") or ui.get("ckpt_name")

    clip_nodes = _first_node(graph, {"CLIPLoader"})
    clip = None
    if clip_nodes:
        ci = clip_nodes[0][2].get("inputs") or {}
        clip = {"clip_name": ci.get("clip_name"), "type": ci.get("type")}

    vae_nodes = _first_node(graph, {"VAELoader"})
    vae = None
    if vae_nodes:
        vae = (vae_nodes[0][2].get("inputs") or {}).get("vae_name")

    model, variant = _match_local_files(unet, clip, vae)
    inputs = (first or {}).get("inputs") or {}
    brief = _sampler_brief(first)
    width, height = _first_pass_size(graph, first)
    pass1 = dict(width=width, height=height, **brief)
    pass1.pop("seed", None)

    pass2 = None
    if second is not None:
        pass2 = _sampler_brief(second)
        pass2.pop("seed", None)
        pass2.update(_upscale_info(graph, second))

    loras = []
    for node in _collect_loras(graph, first):
        li = node.get("inputs") or {}
        name = li.get("lora_name")
        strength = _num(li.get("strength_model"))
        if strength is None:
            strength = _num(li.get("strength"))
        if name:
            loras.append({"name": _file_to_lora_name(name),
                          "strength": 1.0 if strength is None else strength})

    save = _first_node(graph, {"SaveImage"})
    prefix = None
    if save:
        prefix = (save[0][2].get("inputs") or {}).get("filename_prefix")

    missing_models = []
    if unet and model is None:
        missing_models.append(str(unet))
    if clip and clip.get("clip_name"):
        if model is None or not _clip_ok(model, clip):
            missing_models.append(str(clip["clip_name"]))
    if vae and (model is None or not _vae_ok(model, vae)):
        missing_models.append(str(vae))
    upscaler = (pass2 or {}).get("upscale")
    if upscaler and _norm_file(upscaler) not in _known_upscale_models():
        missing_models.append(str(upscaler))
    known_nodes = _known_node_classes()
    for nid, node in graph.items():
        if not isinstance(node, dict):
            continue
        cls = node.get("class_type")
        if cls and cls not in known_nodes:
            missing_models.append(f"node:{cls}")

    if model:
        if (clip and not _clip_ok(model, clip)) or (vae and not _vae_ok(model, vae)):
            confidence = "partial"
        else:
            confidence = "exact"
    elif clip or vae:
        confidence = "partial"
    else:
        confidence = "none"

    recipe = {
        "model": model,
        "variant": variant,
        "confidence": confidence,
        "unet": unet,
        "clip": clip,
        "vae": vae,
        "seed": brief.get("seed"),
        "pass1": pass1,
        "pass2": pass2,
        "loras": loras,
        "positive": _text_from_link(graph, inputs.get("positive")),
        "negative": _text_from_link(graph, inputs.get("negative")),
        "prompt_prefix": prefix,
    }
    if missing_models:
        recipe["missing_models"] = sorted(set(missing_models))
    return recipe


def recipes_from_comfy_api(graph):
    """从 ComfyUI SaveImage 写入的 API 图（prompt 块）反解配方。"""
    return _comfy_recipe(graph)


def _split_a1111_params(text):
    parts = re.split(r",\s*(?=[A-Za-z][A-Za-z0-9 _()+\-]{0,32}:)", text or "")
    out = {}
    for part in parts:
        key, sep, value = part.partition(":")
        if sep and key.strip():
            out[key.strip().lower()] = value.strip()
    return out


_A1111_SAMPLERS = {
    "euler a": "euler_ancestral", "euler": "euler",
    "lms": "lms", "heun": "heun", "dpm2": "dpm_2",
    "dpm2 a": "dpm_2_ancestral", "dpm++ 2m": "dpmpp_2m",
    "dpm++ 2m karras": "dpmpp_2m", "dpm++ sde": "dpmpp_sde",
    "dpm++ sde karras": "dpmpp_sde", "ddim": "ddim", "unipc": "uni_pc",
}


def _a1111_sampler(text):
    raw = (text or "").strip().lower()
    return _A1111_SAMPLERS.get(raw, (text or "").strip() or None)


def _a1111_scheduler(sampler, schedule):
    if schedule:
        s = schedule.strip().lower()
        if s in ("karras", "exponential", "sgm uniform", "simple",
                 "normal", "ddim uniform", "beta"):
            return s.replace(" ", "_")
    if "karras" in (sampler or "").lower():
        return "karras"
    return "normal"


def _int_from(value):
    m = re.search(r"-?\d+", str(value or ""))
    return int(m.group(0)) if m else None


def _float_from(value):
    m = re.search(r"-?(?:\d+\.\d+|\d+)", str(value or ""))
    return float(m.group(0)) if m else None


def _match_model_name(raw):
    if not raw:
        return None, None
    text = str(raw).strip()
    if text.lower() in MODELS:
        model = text.lower()
        return model, MODELS[model].get("default_variant")
    norm = _norm_file(text)
    if norm in MODELS:
        return norm, MODELS[norm].get("default_variant")
    hits = _unet_index().get(norm)
    if hits:
        return hits[0]
    for model, cfg in MODELS.items():
        if _norm_file(cfg.get("display")) == norm:
            return model, cfg.get("default_variant")
    return None, None


def recipes_from_a1111(text):
    """解析 A1111/Forge 的 parameters 文本。字段缺失时降级为 None。"""
    text = text or ""
    lines = text.splitlines()
    neg_idx = steps_idx = None
    for i, line in enumerate(lines):
        if neg_idx is None and line.startswith("Negative prompt:"):
            neg_idx = i
        if re.match(r"^\s*Steps:\s*", line):
            steps_idx = i
            break

    positive = ""
    negative = ""
    if neg_idx is not None:
        positive = "\n".join(lines[:neg_idx]).strip()
        end = steps_idx if steps_idx is not None and steps_idx >= neg_idx else len(lines)
        neg_lines = [lines[neg_idx][len("Negative prompt:"):].strip()]
        neg_lines += lines[neg_idx + 1:end]
        negative = "\n".join(neg_lines).strip()
    elif steps_idx is not None:
        positive = "\n".join(lines[:steps_idx]).strip()
    else:
        positive = text.strip()

    params_line = "\n".join(lines[steps_idx:]) if steps_idx is not None else ""
    params = _split_a1111_params(params_line)

    model_raw = params.get("model") or params.get("model name")
    model, variant = _match_model_name(model_raw)
    if model is None and model_raw:
        # 模型名里带路径/扩展名时，再用 unet 文件名做一次精确比对
        model, variant = _match_model_name(_norm_file(model_raw))

    size_w = size_h = None
    m = re.search(r"(\d+)\s*[xX\u00d7]\s*(\d+)", params.get("size") or "")
    if m:
        size_w, size_h = int(m.group(1)), int(m.group(2))

    steps = _int_from(params.get("steps"))
    cfg = _float_from(params.get("cfg scale"))
    seed = _int_from(params.get("seed"))
    sampler_raw = params.get("sampler")
    sampler = _a1111_sampler(sampler_raw)
    scheduler = _a1111_scheduler(sampler_raw, params.get("schedule type"))
    denoise = _float_from(params.get("denoising strength"))

    pass1 = dict(width=size_w, height=size_h, steps=steps, cfg=cfg,
                 sampler=sampler, scheduler=scheduler,
                 denoise=1.0 if denoise is None else denoise)
    loras = []
    for lm in re.finditer(r"<lora:([^:>]+):([^>]+)>", positive):
        strength = _float_from(lm.group(2))
        loras.append({"name": _file_to_lora_name(lm.group(1).strip()),
                      "strength": 1.0 if strength is None else strength})

    pass2 = None
    hires_scale = _float_from(params.get("hires upscale"))
    if hires_scale or denoise is not None:
        pass2 = dict(steps=_int_from(params.get("hires steps")) or steps,
                     cfg=cfg, sampler=sampler, scheduler=scheduler,
                     denoise=denoise)
        if hires_scale:
            pass2["scale_by"] = hires_scale
        if params.get("hires upscaler"):
            pass2["upscale"] = params["hires upscaler"]
            pass2["upscale_mode"] = "pixel"

    recipe = {
        "model": model,
        "variant": variant,
        "confidence": "exact" if model else "none",
        "unet": None,
        "clip": None,
        "vae": params.get("vae"),
        "seed": seed,
        "pass1": pass1,
        "pass2": pass2,
        "loras": loras,
        "positive": positive,
        "negative": negative,
        "prompt_prefix": None,
    }
    if model_raw and model is None:
        recipe["model"] = model_raw
        recipe["model_raw"] = model_raw
        recipe["missing"] = ["model"]
    vae = params.get("vae")
    if model and vae and _norm_file(vae) not in _known_vaes(model):
        recipe["missing"] = sorted(set(recipe.get("missing", []) + ["vae"]))
        recipe["confidence"] = "partial"
    return recipe


def recipes_from_novelai(obj):
    obj = obj or {}
    prompt = obj.get("prompt") or ""
    negative = obj.get("uc") or ""
    steps = _num(obj.get("steps"))
    cfg = _num(obj.get("scale"))
    seed = _num(obj.get("seed"))
    sampler = obj.get("sampler")
    scheduler = obj.get("noise_schedule")
    size = {"width": _num(obj.get("width")),
            "height": _num(obj.get("height"))}
    return {
        "model": None, "variant": None, "confidence": "none",
        "unet": None, "clip": None, "vae": None, "seed": seed,
        "pass1": dict(width=size["width"], height=size["height"],
                      steps=steps, cfg=cfg, sampler=sampler,
                      scheduler=scheduler, denoise=1.0),
        "pass2": None, "loras": [], "positive": prompt,
        "negative": negative, "prompt_prefix": None,
        "missing": ["model"],
    }


def recipes_from_fooocus(obj):
    obj = obj or {}
    prompt = obj.get("prompt") or ""
    negative = obj.get("negative_prompt") or ""
    steps = _num(obj.get("steps"))
    cfg = _num(obj.get("guidance_scale"))
    seed = _num(obj.get("seed"))
    model_raw = obj.get("base_model") or obj.get("model")
    model, variant = _match_model_name(model_raw)
    width = _num(obj.get("width"))
    height = _num(obj.get("height"))
    recipe = {
        "model": model, "variant": variant,
        "confidence": "exact" if model else "none",
        "unet": None, "clip": None, "vae": obj.get("vae"),
        "seed": seed,
        "pass1": dict(width=width, height=height, steps=steps, cfg=cfg,
                      sampler=obj.get("sampler"),
                      scheduler=obj.get("scheduler"), denoise=1.0),
        "pass2": None, "loras": [], "positive": prompt,
        "negative": negative, "prompt_prefix": None,
    }
    if model_raw and model is None:
        recipe["model"] = model_raw
        recipe["model_raw"] = model_raw
        recipe["missing"] = ["model"]
    return recipe


def _eq(a, b, tol=1e-6):
    if a is None or b is None:
        return a is b
    try:
        return abs(float(a) - float(b)) <= tol
    except (TypeError, ValueError):
        return a == b


def _preset_match(model, recipe):
    cfg = MODELS.get(model)
    if not cfg:
        return None, "模型不在本机 MODELS"
    p1 = recipe.get("pass1") or {}
    p2 = recipe.get("pass2")
    for name, preset in (cfg.get("presets") or {}).items():
        if not (_eq(p1.get("width"), preset.get("width"))
                and _eq(p1.get("height"), preset.get("height"))
                and _eq(p1.get("steps"), preset.get("steps"))
                and _eq(p1.get("cfg"), preset.get("cfg"))
                and p1.get("sampler") == preset.get("sampler")
                and p1.get("scheduler") == preset.get("scheduler")
                and _eq(p1.get("denoise"), preset.get("denoise"))):
            continue
        want_two = bool(preset.get("two_pass"))
        if want_two:
            if not p2:
                continue
            if not (_eq(p2.get("steps"), preset.get("steps2"))
                    and _eq(p2.get("cfg"), preset.get("cfg"))
                    and p2.get("sampler") == preset.get("sampler")
                    and p2.get("scheduler") == preset.get("scheduler")
                    and _eq(p2.get("denoise"), preset.get("denoise2"))):
                continue
            mode = preset.get("upscale_mode", "latent")
            if p2.get("upscale_mode", "latent") != mode:
                continue
            if mode == "pixel":
                ratio = float(preset.get("upscale_ratio", 2.0) or 2.0)
                expected_by = float(preset.get("scale", 1)) / ratio
                if not _eq(p2.get("scale_by"), expected_by):
                    continue
                if preset.get("upscale_model") and _norm_file(
                        p2.get("upscale")) != _norm_file(
                            preset["upscale_model"]):
                    continue
            elif not _eq(p2.get("scale_by"), preset.get("scale")):
                continue
            preset_vae = preset.get("vae")
            if preset_vae and recipe.get("vae") and _norm_file(
                    recipe["vae"]) != _norm_file(preset_vae):
                continue
        elif p2:
            continue
        return name, None
    if p2:
        return None, "二采链路与本机任何 preset 都不一致"
    return None, "steps/cfg 与本机任何 preset 都不一致"


def _fmt_num(value):
    try:
        return f"{float(value):g}"
    except (TypeError, ValueError):
        return str(value)


def _build_replay(recipe, preset_name):
    model = recipe.get("model")
    unmapped = []
    notes = []
    if model not in MODELS:
        return ({"args": [],
                 "note": "模型不在本机 MODELS，无法生成可执行的 replay"},
                ["model"], [])
    cfg = MODELS[model]
    args = ["-m", model]
    variant = recipe.get("variant")
    if variant and variant != cfg.get("default_variant"):
        args += ["--variant", variant]

    p1 = recipe.get("pass1") or {}
    p2 = recipe.get("pass2")
    if preset_name:
        if preset_name != DEFAULT_PRESET.get(model):
            args += ["--preset", preset_name]
    else:
        width, height = p1.get("width"), p1.get("height")
        if width and height:
            width, height = int(width), int(height)
            if (width % 64 == 0 and height % 64 == 0
                    and width * height <= 2048 * 2048):
                args += ["--size", f"{width}x{height}"]
            else:
                unmapped.append("size")
        base_steps = cfg.get("custom_steps", 8)
        if p1.get("steps") is not None and not _eq(p1["steps"], base_steps):
            args += ["--steps", str(int(p1["steps"]))]
        if p1.get("cfg") is not None and not _eq(p1["cfg"], 1.0):
            args += ["--cfg", _fmt_num(p1["cfg"])]
        if p1.get("denoise") is not None and not _eq(p1["denoise"], 1.0):
            args += ["--denoise", _fmt_num(p1["denoise"])]
        if p2:
            unmapped.extend(["pass2.steps", "pass2.denoise", "pass2.scale"])
            if p2.get("upscale"):
                unmapped.append("pass2.upscale")
            notes.append("二采链路没有命中本机 preset，无法用单采参数复现")

    if p1.get("sampler") and p1["sampler"] != "euler":
        unmapped.append("sampler")
    if p1.get("scheduler") and p1["scheduler"] != "simple":
        unmapped.append("scheduler")

    vae = recipe.get("vae")
    if vae:
        preset = cfg["presets"].get(preset_name or "") or {}
        accepted = {_norm_file(cfg.get("vae")), _norm_file(preset.get("vae"))}
        accepted.discard("")
        if _norm_file(vae) not in accepted:
            if _norm_file(vae) in _known_vaes(model):
                args += ["--vae", vae]
            else:
                unmapped.append("vae")

    if recipe.get("negative"):
        args += ["--negative", recipe["negative"]]

    default_lora = _norm_file(cfg.get("default_lora"))
    max_steps = cfg.get("default_lora_max_steps", 8)
    for item in recipe.get("loras") or []:
        name = item.get("name")
        if not name:
            continue
        if default_lora and _norm_file(name) == default_lora:
            steps = p1.get("steps")
            if steps is None or steps <= max_steps:
                continue
        strength = item.get("strength")
        args += ["--lora", name if strength is None
                 else f"{name}:{_fmt_num(strength)}"]

    if recipe.get("seed") is not None:
        args += ["--seed", str(int(recipe["seed"]))]

    replay = {"args": args}
    if notes:
        replay["note"] = "; ".join(notes)
    return replay, unmapped, []


def inspect_image(path):
    """返回 (payload, exit_code)，纯只读，不触发任何生成。"""
    info = parse_metadata(path)
    if not info.get("ok"):
        err = info.get("error") or "no_metadata"
        payload = {"ok": False, "error": err}
        if err != "no_metadata":
            payload["image"] = info.get("image")
        return payload, 2

    source = info.get("source")
    if source == "comfyui":
        recipe = recipes_from_comfy_api(info.get("comfy_api"))
    elif source == "a1111":
        recipe = recipes_from_a1111(info.get("a1111"))
    elif source == "novelai":
        recipe = recipes_from_novelai(info.get("comment"))
    else:
        recipe = recipes_from_fooocus(info.get("fooocus"))

    model = recipe.get("model")
    preset_name, preset_reason = _preset_match(model, recipe)
    replay, unmapped, _ = _build_replay(recipe, preset_name)

    missing = list(recipe.pop("missing", []) or [])
    missing_models = list(recipe.pop("missing_models", []) or [])
    if model in MODELS and not preset_name:
        missing.append("preset")

    if model not in MODELS:
        matches_local = None
    else:
        matches_local = {"preset": preset_name}
        if preset_reason:
            matches_local["reason"] = preset_reason

    payload = {
        "ok": True,
        "image": info["image"],
        "source": source,
        "size": info.get("size"),
        "recipe": recipe,
        "matches_local": matches_local,
        "missing": sorted(set(missing)),
        "unmapped": sorted(set(unmapped)),
        "replay": replay,
        "raw": info.get("raw") or {},
    }
    if missing_models:
        payload["missing_models"] = sorted(set(missing_models))
    return payload, (4 if missing_models else 0)


def _inspect_parser():
    class JsonParser(argparse.ArgumentParser):
        def error(self, message):
            fail(2, "bad_args", message, "运行 imggen --list 查看完整能力清单")

    ap = JsonParser(prog="imggen inspect",
                    description="从图片元数据反解 imggen 配方（只读）")
    ap.add_argument("images", nargs="+", metavar="IMAGE")
    return ap


def do_inspect(argv):
    a = _inspect_parser().parse_args(argv)
    results = []
    codes = []
    for path in a.images:
        payload, code = inspect_image(path)
        results.append(payload)
        codes.append(code)
    if len(results) == 1:
        emit(results[0])
        return codes[0]
    ok = all(r.get("ok") for r in results)
    emit({"ok": ok, "results": results,
          **({"error": "some_images_failed"} if not ok else {})})
    return max(codes)


# ----------------------------------------------------------------------------
# 尺寸 / 参数
# ----------------------------------------------------------------------------
def round64(v):
    return max(64, int(round(v / 64.0)) * 64)


def detect_prompt_style(text):
    """词法判断提示词形态：tag / natural / mixed。

    只做标注，不改写提示词。引号内的画面文字（文字渲染）不参与判断。
    """
    t = (text or "").strip()
    if not t:
        return "empty"
    # MOSS 官方 layout 提示词就是一段 JSON 对象，不能按 tag 处理
    try:
        if isinstance(json.loads(t), dict):
            return "layout"
    except (TypeError, ValueError):
        pass
    s = re.sub(r'"[^"]*"|“[^”]*”|「[^」]*」', " ", t)
    parts = [p.strip() for p in re.split(r"[,，\n]+", s) if p.strip()]
    if not parts:
        return "natural"
    sentences = len(re.findall(r"[.!?。！？]", s))
    counts = [len(re.findall(r"[A-Za-z0-9']+|[\u4e00-\u9fff]", p))
              for p in parts]
    avg = sum(counts) / len(counts)
    long_parts = sum(1 for c in counts if c > 10)
    # 自然语言里冠词/介词/连词密度高；tag 基本只有名词和形容词
    markers = len(re.findall(
        r"\b(a|an|the|of|with|in|on|at|wearing|standing|looking|while|"
        r"and|but|from|into|under|over|his|her|their|is|are|was)\b",
        s, re.I))
    if (len(parts) >= 4 and avg <= 3.5 and sentences == 0
            and long_parts == 0 and markers < 8):
        return "tag"
    # 3 段短 tag 也常见（1girl, black hair, purple eyes）；但没有冠词/介词/连词，
    # 以免把 "a cat, a dog, and a bird" 这类自然列举误判成 tag
    if (len(parts) == 3 and avg <= 3.5 and sentences == 0
            and long_parts == 0 and markers == 0):
        return "tag"
    if sentences >= 1 or avg >= 6 or markers >= 8:
        return "natural"
    return "mixed"


def _merge_variant(dst, src):
    for k, v in src.items():
        if isinstance(v, dict) and isinstance(dst.get(k), dict):
            _merge_variant(dst[k], v)
        else:
            dst[k] = v


def resolve_variant(a):
    """把 MODELS[model] 与选中的权重变体合并成当前生效的模型配置。"""
    base = MODELS[a.model]
    variants = base.get("variants") or {}
    name = a.variant or os.environ.get("IMGPOOL_VARIANT") or base.get(
        "default_variant")
    if not variants:
        if name is not None:
            fail(2, "bad_variant", f"{a.model} 没有定义权重变体",
                 "在 MODELS 里加 variants 后可用")
        cfg = json.loads(json.dumps(base))
        cfg.pop("variants", None)
        cfg["variant"] = "default"
        return cfg
    if name not in variants:
        fail(2, "bad_variant", f"{a.model} 没有变体 {name!r}",
             "可选：" + (", ".join(sorted(variants)) if variants
                         else "该模型没有定义变体"))
    cfg = json.loads(json.dumps(base))
    cfg.pop("variants", None)
    _merge_variant(cfg, variants[name])
    cfg["variant"] = name
    return cfg


# 局部重绘的四档预设。每档只改 denoise 和 crop 的生成分辨率：
# pad/feather 决定接缝，不决定细节量，四档保持一致。
REFINE_LEVELS = {
    1: {"name": "integrate", "denoise": 0.12, "long_edge": 1024,
        "pad": 64, "feather": 32},
    2: {"name": "light", "denoise": 0.35, "long_edge": 1024,
        "pad": 64, "feather": 32},
    3: {"name": "detail", "denoise": 0.45, "long_edge": 1024,
        "pad": 64, "feather": 32},
    4: {"name": "strong", "denoise": 0.55, "long_edge": 1024,
        "pad": 64, "feather": 32},
}


def apply_refine_level(a):
    """把档位默认值填进未显式指定的 refine 参数。"""
    lv = REFINE_LEVELS[a.refine_level]
    if a.refine_denoise is None:
        a.refine_denoise = lv["denoise"]
    if a.refine_pad is None:
        a.refine_pad = lv["pad"]
    if a.refine_long_edge is None:
        a.refine_long_edge = lv["long_edge"]
    if a.refine_feather is None:
        a.refine_feather = lv["feather"]


def refine_spec(a):
    steps = a.steps or a.mcfg.get("custom_steps", 8)
    return dict(width=0, height=0, steps=steps,
                cfg=1.0 if a.cfg is None else a.cfg,
                sampler="euler", scheduler="simple",
                denoise=0.12 if a.refine_denoise is None else a.refine_denoise,
                vae=a.vae or a.mcfg["vae"], vae_tiled=True)


def _copy_image(path, prefix):
    """把本地图片复制进 ComfyUI/input，按内容哈希去重。"""
    src = os.path.abspath(os.path.expanduser(path))
    if not os.path.isfile(src):
        fail(2, "file_not_found", f"图片不存在：{src}")
    ext = os.path.splitext(src)[1].lower() or ".png"
    if ext not in (".png", ".jpg", ".jpeg", ".webp", ".bmp"):
        fail(2, "bad_image", f"不支持的图片格式：{ext}")
    h = hashlib.sha1(open(src, "rb").read()).hexdigest()[:12]
    name = f"{prefix}_{h}{ext}"
    os.makedirs(INPUT_DIR, exist_ok=True)
    dst = os.path.join(INPUT_DIR, name)
    if not os.path.exists(dst):
        shutil.copyfile(src, dst)
    return name, src


def prepare_refine(a):
    """读源图/区域，算 crop 计划，并把羽化后的 mask 写进 input。"""
    from PIL import Image, ImageDraw, ImageFilter

    src_name, src = _copy_image(a.inpaint, "imggen_inpaint")
    im = Image.open(src)
    W, H = im.size

    if a.rect:
        m = re.fullmatch(r"\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)\s*",
                         a.rect)
        if not m:
            fail(2, "bad_rect", f"--rect 需要 X,Y,W,H，收到 {a.rect!r}",
                 "例：--rect 600,500,400,450")
        x, y, w, h = (int(v) for v in m.groups())
        if w <= 0 or h <= 0 or x < 0 or y < 0 or x + w > W or y + h > H:
            fail(2, "bad_rect",
                 f"--rect {a.rect} 超出图片范围 {W}x{H}",
                 f"x+w ≤ {W}，y+h ≤ {H}")
        mask = Image.new("L", (W, H), 0)
        ImageDraw.Draw(mask).rectangle((x, y, x + w - 1, y + h - 1), fill=255)
    else:
        mask_name_in, mask_path = _copy_image(a.mask, "imggen_mask_in")
        mask = Image.open(mask_path).convert("L")
        if mask.size != (W, H):
            fail(2, "mask_size_mismatch",
                 f"mask {mask.size[0]}x{mask.size[1]} 与源图 {W}x{H} 不一致",
                 "mask 按原图像素坐标绘制，不需要缩放")
        bbox = mask.point(lambda v: 255 if v > 127 else 0).getbbox()
        if not bbox:
            fail(2, "empty_mask", "mask 全黑，没有可重绘的区域",
                 "白色（>127）才是重绘区域")
        x, y, w, h = bbox[0], bbox[1], bbox[2] - bbox[0], bbox[3] - bbox[1]

    pad = max(0, a.refine_pad)
    cx, cy = max(0, x - pad), max(0, y - pad)
    cw = min(W - cx, w + 2 * pad)
    ch = min(H - cy, h + 2 * pad)
    cw -= cw % 8
    ch -= ch % 8
    if cw < 64 or ch < 64:
        fail(2, "region_too_small", f"重绘区域只有 {cw}x{ch}，最小 64x64")

    long_edge = max(64, a.refine_long_edge)
    scale = long_edge / max(cw, ch)
    tw = max(64, int(round(cw * scale / 16)) * 16)
    th = max(64, int(round(ch * scale / 16)) * 16)

    # 采样 mask：向内缩一圈再轻羽化，让重绘内容离开矩形边界，
    # 避免 VAE 在裁剪边缘留下的亮边直接贴到原图上。
    if a.refine_shrink is None:
        shrink = max(8, a.refine_feather // 2)
    else:
        shrink = max(0, a.refine_shrink)

    key = hashlib.sha1(
        f"{W}x{H}|{cx},{cy},{cw},{ch}|{a.refine_feather}|{shrink}".encode()
    ).hexdigest()[:12]
    mask_name = f"imggen_refine_mask_{key}.png"
    sample_name = f"imggen_refine_sample_{key}.png"
    os.makedirs(INPUT_DIR, exist_ok=True)
    # 贴回 mask：高斯软边，边界只做颜色过渡。
    soft = mask.filter(ImageFilter.GaussianBlur(
        radius=max(1.0, a.refine_feather / 3.0)))
    soft.convert("RGB").save(os.path.join(INPUT_DIR, mask_name))
    if shrink:
        inner = mask.filter(ImageFilter.MinFilter(2 * shrink + 1))
    else:
        inner = mask
    inner = inner.filter(ImageFilter.GaussianBlur(
        radius=max(1.0, shrink / 2.0)))
    inner.convert("RGB").save(os.path.join(INPUT_DIR, sample_name))

    return (src_name, mask_name, sample_name,
            (cx, cy, cw, ch, tw, th), shrink, (W, H))


def prepare_anypaint(a):
    """读源图/区域，写 AnyPaint 用的 mask（白=重绘，不做羽化）。

    边界融合交给 AnyPaint 的 boundary_redraw_px，mask 本身保持硬边。
    """
    from PIL import Image, ImageDraw

    src_name, src = _copy_image(a.anypaint, "imggen_anypaint")
    im = Image.open(src)
    W, H = im.size

    if a.rect:
        m = re.fullmatch(r"\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)\s*",
                         a.rect)
        if not m:
            fail(2, "bad_rect", f"--rect 需要 X,Y,W,H，收到 {a.rect!r}",
                 "例：--rect 600,500,400,450")
        x, y, w, h = (int(v) for v in m.groups())
        if w <= 0 or h <= 0 or x < 0 or y < 0 or x + w > W or y + h > H:
            fail(2, "bad_rect", f"--rect {a.rect} 超出图片范围 {W}x{H}",
                 f"x+w ≤ {W}，y+h ≤ {H}")
        mask = Image.new("L", (W, H), 0)
        ImageDraw.Draw(mask).rectangle((x, y, x + w - 1, y + h - 1),
                                       fill=255)
        key_src = a.rect
    else:
        _, mask_path = _copy_image(a.mask, "imggen_mask_in")
        mask = Image.open(mask_path).convert("L")
        if mask.size != (W, H):
            fail(2, "mask_size_mismatch",
                 f"mask {mask.size[0]}x{mask.size[1]} 与源图 {W}x{H} 不一致",
                 "mask 按原图像素坐标绘制，不需要缩放")
        key_src = hashlib.sha1(mask.tobytes()).hexdigest()[:12]

    if not mask.point(lambda v: 255 if v > 127 else 0).getbbox():
        fail(2, "empty_mask", "mask 全黑，没有可重绘的区域",
             "白色（>127）才是重绘区域")

    key = hashlib.sha1(f"{W}x{H}|{key_src}|{a.anypaint_boundary}".encode()
                       ).hexdigest()[:12]
    mask_name = f"imggen_anypaint_mask_{key}.png"
    os.makedirs(INPUT_DIR, exist_ok=True)
    mask.convert("RGB").save(os.path.join(INPUT_DIR, mask_name))
    return src_name, mask_name, (W, H)


def anypaint_spec(a, size):
    """AnyPaint 固定 denoise=1，尺寸跟源图一致。"""
    return dict(width=size[0], height=size[1],
                steps=8 if a.steps is None else a.steps,
                cfg=1.0 if a.cfg is None else a.cfg,
                sampler="euler", scheduler="simple", denoise=1.0,
                vae=a.vae or a.mcfg["vae"])


def _two_pass_align(scale, out_align=16):
    """首采对齐基数：align 是 16 的倍数，且 align×scale 是 out_align 的整数倍。

    1.25 需要 64、1.5 需要 32、1.6 需要 80、2.0 只需要 16。
    """
    for align in range(16, 4096, 16):
        out = align * scale
        if abs(out - round(out)) < 1e-6 and int(round(out)) % out_align == 0:
            return align
    fail(2, "bad_scale_align",
         f"scale {scale:g} 在 16 对齐网格上无法得到 {out_align} 对齐的输出",
         "换一个 scale（如 1.5 / 1.6 / 2.0）")


def _fit_aspect(spec, ra, rb):
    """保持预设像素面积，按比例重算首采尺寸，并满足 VAE 对齐和单边上限。"""
    area = spec["width"] * spec["height"]
    align = 16
    limit = 2048
    if spec.get("two_pass"):
        align = _two_pass_align(spec["scale"])
        # 二采输出单边也要 ≤ 2048，首采上限相应收紧
        limit = int(2048 / spec["scale"])
    limit = max(align, int(limit / align) * align)

    w = int(round(math.sqrt(area * ra / rb) / align)) * align
    h = int(round(w * rb / ra / align)) * align
    shrunk = False
    if max(w, h) > limit:
        k = limit / max(w, h)
        w = max(align, int(w * k / align) * align)
        h = max(align, int(round(w * rb / ra) / align) * align)
        shrunk = True

    if w < 64 or h < 64:
        fail(2, "bad_aspect", f"{ra:g}:{rb:g} 在当前面积下算出的尺寸 {w}x{h} 太小",
             "换一个更接近正方形的比例，或换更大的 preset")

    actual = w * h
    # 单边上限导致的缩面积是预期行为，不算比例误差
    if not shrunk and abs(actual - area) / area > 0.10:
        fail(2, "bad_aspect_area",
             f"{ra:g}:{rb:g} 在 {align} 对齐下面积从 {area/1e6:.2f}MP "
             f"变成 {actual/1e6:.2f}MP，偏差超过 10%",
             "换一个比例，或直接用 --size 指定尺寸")

    if spec.get("two_pass"):
        ow, oh = w * spec["scale"], h * spec["scale"]
        if (abs(ow - round(ow)) > 1e-6 or abs(oh - round(oh)) > 1e-6
                or int(round(ow)) % 16 or int(round(oh)) % 16):
            fail(2, "bad_aspect_scale",
                 f"{ra:g}:{rb:g} × scale {spec['scale']:g} 的输出 "
                 f"{ow:g}x{oh:g} 不是 16 的倍数",
                 "换一个比例或 scale")

    spec["width"], spec["height"] = w, h


# --native 选中的是最终输出尺寸，必须走单采：二采输出会是档位 × scale，
# 不再是原生分辨率。预设专属的 VAE 覆盖（如 MOSS 1280 的 taef2）不带走；
# vae_tiled / vae_tile_size 是显存安全开关，不属于二采语义，保留预设值。
_NATIVE_CLEAR_KEYS = (
    "two_pass", "scale", "steps2", "denoise2", "upscale_mode",
    "upscale_model", "upscale_ratio", "upscale_method",
    "latent_steps2", "latent_denoise2", "vae",
)


def _parse_aspect(text):
    m = re.fullmatch(r"(\d+(?:\.\d+)?)\s*[:xX/]\s*(\d+(?:\.\d+)?)",
                     text.strip())
    if not m:
        fail(2, "bad_aspect", f"--aspect 需要 W:H 格式，收到 {text!r}",
             "例：--aspect 1:1 / 16:9 / 9:16 / 4:5 / 3:2")
    ra, rb = float(m.group(1)), float(m.group(2))
    if not (math.isfinite(ra) and math.isfinite(rb)) or ra <= 0 or rb <= 0:
        fail(2, "bad_aspect", f"--aspect 的宽高必须是有限正数：{text!r}")
    return ra, rb


def _aspect_text(ra, rb):
    """把 --aspect 输入规范成去掉多余小数的 W:H。"""
    return f"{ra:g}:{rb:g}"


def _aspect_label(w, h):
    """结果 JSON 用的精确像素比例，例如 1664:928。"""
    return f"{int(w)}:{int(h)}"


def _native_aspect_warning(requested, w, h):
    """请求比例与最近原生档位有明显偏差时给出可见提示。"""
    if not requested:
        return None
    try:
        ra, rb = (float(v) for v in requested.split(":"))
        target = ra / rb
        actual = w / h
        if not (math.isfinite(target) and math.isfinite(actual)):
            return None
        if abs(math.log(actual / target)) > math.log(1.02):
            return (f"native_aspect_snapped（请求 {requested}，"
                    f"最近原生档位是 {w}x{h}，实际 {_aspect_label(w, h)}）")
    except (ValueError, ZeroDivisionError):
        pass
    return None


def _snap_native(spec, ra, rb, sizes):
    """在原生档位里按 log-aspect 距离选最近的一档，忽略预设面积。"""
    candidates = []
    for size in sizes or []:
        try:
            if isinstance(size, dict):
                w, h = int(size["width"]), int(size["height"])
            else:
                w, h = int(size[0]), int(size[1])
        except (KeyError, TypeError, ValueError, IndexError):
            fail(2, "bad_native_sizes", f"原生档位格式错误：{size!r}")
        if w <= 0 or h <= 0:
            fail(2, "bad_native_sizes",
                 f"原生档位 {w}x{h} 的宽高必须大于 0")
        if max(w, h) > 2048 or w * h > 2048 * 2048:
            fail(2, "native_size_too_large",
                 f"原生档位 {w}x{h} 超过本机已验证上限 2048x2048",
                 "改用 --size 或 --aspect（不加 --native）")
        candidates.append((w, h))
    if not candidates:
        fail(2, "no_native_sizes", "当前模型没有登记原生分辨率档位",
             "用 --size 或 --aspect（不加 --native）指定尺寸")

    target = ra / rb
    if not math.isfinite(target) or target <= 0:
        fail(2, "bad_aspect", f"无法计算比例 {ra:g}:{rb:g}",
             "换一个正常的 W:H")
    w, h = min(candidates,
               key=lambda wh: abs(math.log((wh[0] / wh[1]) / target)))
    spec["width"], spec["height"] = w, h
    for key in _NATIVE_CLEAR_KEYS:
        spec.pop(key, None)
    return w, h


def resolve_spec(a):
    """返回 (spec, preset_name, custom)。--size/--width/--height 走单采。"""
    cfg = a.mcfg
    custom = a.size is not None or a.width is not None or a.height is not None
    native = bool(getattr(a, "native", False))
    a.native_snapped = False
    a.requested_aspect = None

    if custom and a.aspect:
        fail(2, "bad_args", "--aspect 与 --size/--width/--height 不能同时使用",
             "--size 直接给尺寸，--aspect 只给比例")
    if custom and native:
        fail(2, "bad_args", "--native 与 --size/--width/--height 不能同时使用",
             "--native 从模型原生档位里选，--size 直接给尺寸")
    if native:
        ignored = [flag for flag, value in (
            ("--scale", a.scale), ("--steps2", a.steps2),
            ("--denoise2", a.denoise2), ("--latent", a.latent))
            if value not in (None, False)]
        if ignored:
            fail(2, "bad_args",
                 "--native 走单采，不能同时使用 " + ", ".join(ignored),
                 "原生档位就是最终尺寸；要二采请去掉 --native")

    if custom:
        if a.size:
            m = re.fullmatch(r"(\d+)\s*[xX\u00d7]\s*(\d+)", a.size.strip())
            if not m:
                fail(2, "bad_size", f"--size 需要 WxH 格式，收到 {a.size!r}",
                     "例：--size 1024x1536")
            w, h = int(m.group(1)), int(m.group(2))
        else:
            w = a.width or cfg["presets"][DEFAULT_PRESET[a.model]]["width"]
            h = a.height or cfg["presets"][DEFAULT_PRESET[a.model]]["height"]
        if w % 64 or h % 64:
            fail(2, "bad_size", f"自定义尺寸必须是 64 的倍数，收到 {w}x{h}",
                 f"就近取值：{round64(w)}x{round64(h)}")
        if w * h > 2048 * 2048:
            fail(2, "size_too_large",
                 f"{w}x{h} 超过本机已验证上限 2048x2048",
                 "这台机器 23GB 内存在 2048² 会卡死，建议 ≤1536²")
        spec = dict(width=w, height=h, steps=a.steps or cfg["custom_steps"],
                    cfg=1.0 if a.cfg is None else a.cfg,
                    sampler="euler", scheduler="simple", denoise=1.0)
        if a.vae_tiled:
            spec["vae_tiled"] = True
        return spec, f"custom-{w}x{h}", True

    preset = a.preset or DEFAULT_PRESET[a.model]
    if preset in cfg["presets"]:
        spec = dict(cfg["presets"][preset])
    elif preset in cfg.get("risky_presets", {}):
        if not a.allow_risky:
            fail(2, "risky_preset",
                 f"{a.model}/{preset} 未验证且曾把服务跑挂",
                 "确定要试就加 --allow-risky")
        spec = dict(cfg["risky_presets"][preset])
    else:
        avail = sorted(list(cfg["presets"]) + list(cfg.get("risky_presets", {})))
        fail(2, "bad_preset", f"{a.model} 没有预设 {preset!r}", f"可选：{', '.join(avail)}")

    # --aspect：默认保持预设面积；--native 则忽略面积，吸附到原生档位。
    if a.aspect:
        ra, rb = _parse_aspect(a.aspect)
        a.requested_aspect = _aspect_text(ra, rb)
        if native:
            _snap_native(spec, ra, rb, cfg.get("native_sizes"))
            a.native_snapped = True
        else:
            _fit_aspect(spec, ra, rb)
    elif native:
        _snap_native(spec, spec["width"], spec["height"],
                     cfg.get("native_sizes"))
        a.native_snapped = True

    # --latent：二采回退到 latent 放大（krea2 的 2k 默认是像素放大链路）
    if spec.get("two_pass") and a.latent and spec.get("upscale_mode") == "pixel":
        spec["upscale_mode"] = "latent"
        spec["steps2"] = spec.get("latent_steps2", spec["steps2"])
        spec["denoise2"] = spec.get("latent_denoise2", spec["denoise2"])

    # 显式覆盖
    if a.steps is not None:
        spec["steps"] = a.steps
    if a.steps2 is not None and spec.get("two_pass"):
        spec["steps2"] = a.steps2
    if a.cfg is not None:
        spec["cfg"] = a.cfg
    if a.denoise is not None:
        spec["denoise"] = a.denoise
    if a.denoise2 is not None and spec.get("two_pass"):
        spec["denoise2"] = a.denoise2
    if a.scale is not None and spec.get("two_pass"):
        spec["scale"] = a.scale
        out_w = spec["width"] * a.scale
        out_h = spec["height"] * a.scale
        if abs(out_w - round(out_w / 8) * 8) > 0.51 or abs(out_h - round(out_h / 8) * 8) > 0.51:
            fail(2, "bad_scale",
                 f"二采输出 {out_w:g}x{out_h:g} 不是 8 的倍数，VAE 解码会从 1.5s 变 124s",
                 "换一个让输出对齐 8 的 scale（如 1.5 / 1.6 / 2.0）")
    if a.vae_tiled:
        spec["vae_tiled"] = True
    if a.native_snapped:
        preset = f"native-{spec['width']}x{spec['height']}"
    return spec, preset, False


def resolve_loras(a):
    """解析 --lora NAME[:STRENGTH]，NAME 可写全名或省略 .safetensors。"""
    if not a.lora:
        return []
    try:
        info = http_json("/object_info/LoraLoaderModelOnly", timeout=20)
        names = info["LoraLoaderModelOnly"]["input"]["required"]["lora_name"][0]
    except Exception:
        fail(3, "service_not_ready", "无法从 ComfyUI 读取 LoRA 列表",
             "先运行 bin/comfy-ensure.sh")
    out = []
    for item in a.lora:
        name, strength = item, None
        if ":" in item:
            maybe_name, maybe_s = item.rsplit(":", 1)
            try:
                strength = float(maybe_s)
                name = maybe_name
            except ValueError:
                pass
        alias = LORA_ALIASES.get(name)
        if alias:
            name = alias[0]
        if name not in names:
            if name + ".safetensors" in names:
                name += ".safetensors"
            else:
                fail(2, "unknown_lora", f"LoRA 不存在：{name}",
                     "可用：" + ", ".join(names))
        owner = lora_owner(name, a.model)
        if owner and owner != a.model:
            log(f"[imggen] 警告：{name} 登记在 {owner}，当前模型是 {a.model}")
        if strength is None:
            strength = LORA_DEFAULTS.get(name, a.lora_strength)
        out.append((name, strength))
    return out


# ----------------------------------------------------------------------------
# 提交与等待
# ----------------------------------------------------------------------------
def submit(graph):
    try:
        return http_json("/prompt", {"prompt": graph,
                                     "client_id": str(uuid.uuid4())})
    except urllib.error.HTTPError as e:
        raw = e.read().decode("utf-8", "replace")
        try:
            body = json.loads(raw)
        except Exception:
            body = {"raw": raw[:1200]}
        ne = body.get("node_errors") or {}
        msgs = []
        for nid, info in ne.items():
            for err in info.get("errors", []):
                msgs.append(f"[{nid}] {err.get('message')}: {err.get('details')}")
        fail(5, "prompt_rejected",
             "ComfyUI 拒绝了节点图: " + ("; ".join(msgs) or raw[:600]),
             "加 --dry 检查生成的 graph", node_errors=ne)
    except urllib.error.URLError:
        fail(3, "service_unreachable", f"连不上 {BASE}",
             "运行 bin/comfy-ensure.sh 或检查 systemctl --user status comfyui-2k")


def wait_done(pid, timeout):
    t0 = time.time()
    errs = 0
    last = 0
    while time.time() - t0 < timeout:
        try:
            h = http_json(f"/history/{pid}", timeout=20)
            errs = 0
        except Exception:
            errs += 1
            if errs >= 5:
                fail(6, "server_died", "连续 5 次访问不到服务，ComfyUI 可能已崩溃",
                     f"查看 {LOG} 尾部；重启用 bin/comfy-ensure.sh -f")
            time.sleep(2)
            continue
        if pid in h:
            return h[pid], time.time() - t0
        touch_activity()
        el = int(time.time() - t0)
        if el // 10 != last // 10:
            last = el
            log(f"[imggen] …{el}s")
        time.sleep(1)
    try:
        http_post("/interrupt", timeout=5)
    except Exception:
        pass
    fail(6, "timeout", f"{timeout}s 内未完成，已尝试中断",
         "加大 --timeout，或换更小的 --size")


def collect_images(entry):
    paths = []
    for out in (entry.get("outputs") or {}).values():
        for img in out.get("images") or []:
            if img.get("type", "output") != "output":
                continue
            paths.append(os.path.join(OUTPUT_DIR, img.get("subfolder") or "",
                                      img["filename"]))
    return paths


def entry_error(entry):
    st = entry.get("status") or {}
    if st.get("status_str") != "error" and st.get("completed", True):
        return None
    for msg in st.get("messages") or []:
        if isinstance(msg, list) and len(msg) == 2 and msg[0] in (
                "execution_error", "execution_interrupted"):
            d = msg[1] or {}
            return (msg[0], d.get("node_type"), d.get("exception_message") or d)
    return ("execution_error", None, json.dumps(st, ensure_ascii=False)[:800])


# ----------------------------------------------------------------------------
# --list
# ----------------------------------------------------------------------------
def catalog_models():
    """Build the model/preset capability list without contacting ComfyUI.

    Used by both ``imggen --list`` and ``imgpool GET /models`` so the table
    has a single source of truth.
    """
    models = []
    for name, cfg in MODELS.items():
        presets = []
        for pname, p in list(cfg["presets"].items()) + list(cfg.get("risky_presets", {}).items()):
            risky = pname in cfg.get("risky_presets", {})
            item = {
                "preset": pname,
                "width": p["width"], "height": p["height"],
                "steps": p["steps"], "cfg": p["cfg"],
                "sampler": p["sampler"], "scheduler": p["scheduler"],
                "estimated_seconds_hot": p.get("est_seconds"),
                "risky": risky,
            }
            if p.get("two_pass"):
                item.update({
                    "two_pass": True, "scale": p["scale"],
                    "steps2": p["steps2"], "denoise2": p["denoise2"],
                    "upscale_mode": p.get("upscale_mode", "latent"),
                    "output_width": int(p["width"] * p["scale"]),
                    "output_height": int(p["height"] * p["scale"]),
                })
                if p.get("upscale_model"):
                    item["upscale_model"] = p["upscale_model"]
                item.pop("estimated_seconds_hot")
                item["estimated_seconds_hot"] = p.get("est_seconds")
            presets.append(item)
        models.append({
            "model": name,
            "display": cfg["display"],
            "default_preset": DEFAULT_PRESET[name],
            "unet": cfg["unet"],
            "vae": cfg["vae"],
            "min_available_memory_gb": cfg["min_avail_gb"],
            "min_free_vram_gb": cfg["vram_need_gb"],
            "supports_edit": name == "moss",
            "supports_anypaint": bool(cfg.get("anypaint_lora")),
            "default_lora": cfg.get("default_lora"),
            "supports_tags": cfg.get("supports_tags", True),
            "default_variant": cfg.get("default_variant"),
            "variants": [
                {
                    "name": vname,
                    "display": v.get("display", cfg["display"]),
                    "unet": v.get("unet", cfg["unet"]),
                    "min_available_memory_gb": v.get("min_avail_gb",
                                                     cfg["min_avail_gb"]),
                    "min_free_vram_gb": v.get("vram_need_gb",
                                              cfg["vram_need_gb"]),
                }
                for vname, v in (cfg.get("variants") or {}).items()
            ],
            "notes": cfg["notes"],
            "native_sizes": [
                {"width": w, "height": h, "aspect": _aspect_label(w, h)}
                for w, h in cfg.get("native_sizes", [])
            ],
            "presets": presets,
        })
    return models


def do_list():
    models = catalog_models()
    try:
        info = http_json("/object_info/LoraLoaderModelOnly", timeout=10)
        loras = info["LoraLoaderModelOnly"]["input"]["required"]["lora_name"][0]
    except Exception:
        loras = []
    emit({
        "ok": True,
        "service": {"url": BASE, "up": service_up()},
        "default_model": DEFAULT_MODEL,
        "models": models,
        "loras": loras,
        "lora_aliases": {k: {"file": v[0], "strength": v[1]}
                         for k, v in LORA_ALIASES.items()},
        "lora_groups": lora_groups(),
        "usage": [
            'imggen "提示词"',
            'imggen -m anima "提示词"',
            'imggen -m krea2 --preset 2k "提示词"',
            'imggen -m krea2 --aspect 16:9 --native "提示词"',
            'imggen -m krea2 --preset 2k --latent "提示词"',
            'imggen -m krea2 --preset 2k-direct "提示词"',
            'imggen -m anima --size 1344x768 "提示词"',
            'imggen -m krea2 --lora thick:0.8 "提示词"',
            'imggen -m moss --lora ba "二次元场景"',
            'imggen -m moss --variant sft-int4 "提示词"',
            'imggen -m moss --steps 35 --cfg 3 --negative "worst quality" "提示词"',
            'imggen -m moss --allow-format-mismatch --prompt "1girl, solo"',
            'imggen --edit 图片路径 "编辑指令"',
            'imggen -m krea2 --inpaint 成片.png --rect 600,500,400,450 "描述"',
            'imggen -m krea2 --inpaint 成片.png --rect 600,500,400,450 --refine-level 3 "描述"',
            'imggen -m krea2 --inpaint 成片.png --mask mask.png "描述"',
            'imggen -m krea2 --anypaint 成片.png --rect 600,500,400,450 "描述"',
            'imggen -m krea2 --anypaint 成片.png --mask mask.png --anypaint-sr "描述"',
            'imggen inspect 成片.png',
        ],
        "exit_codes": {"0": "成功", "2": "参数错误", "3": "服务不可用",
                       "4": "内存不足", "5": "提交被拒", "6": "执行失败或超时"},
    })


# ----------------------------------------------------------------------------
# main
# ----------------------------------------------------------------------------
def build_parser():
    class JsonParser(argparse.ArgumentParser):
        def error(self, message):
            fail(2, "bad_args", message, "运行 imggen --list 查看完整能力清单")

    ap = JsonParser(
        prog="imggen", description="LLM 友好的 ComfyUI 出图 CLI（gfx1030 加速版）")
    ap.add_argument("prompt", nargs="?", help="提示词")
    ap.add_argument("-p", "--prompt", dest="prompt_opt", help="提示词（同位置参数）")
    ap.add_argument("--prompt-file", help="从文件读提示词")
    ap.add_argument("-m", "--model", default=DEFAULT_MODEL,
                    help="moss / anima / krea2（默认 moss）")
    ap.add_argument("--variant", help="权重变体，见 --list（默认取模型自带变体）")
    ap.add_argument("--vae", help="覆盖解码器（如 MOSS 二采用 taef2）")
    ap.add_argument("--preset", help="预设名，见 --list")
    ap.add_argument("--size", help="自定义尺寸 WxH（走单采，必须 64 对齐）")
    ap.add_argument("--width", type=int)
    ap.add_argument("--aspect", metavar="W:H",
                    help="按长宽比选尺寸（如 1:1 / 16:9 / 9:16 / 4:5）；"
                         "首采按原预设面积换算，二采按同一比例放大")
    ap.add_argument("--native", action="store_true",
                    help="吸附到模型的原生分辨率档位（忽略预设面积；"
                         "与 --aspect 一起按 log-aspect 选最近档，见 --list）")
    ap.add_argument("--height", type=int)
    ap.add_argument("--seed", default="424242", help="整数或 random")
    ap.add_argument("--steps", type=int, help="覆盖首采步数")
    ap.add_argument("--steps2", type=int, help="覆盖二采步数")
    ap.add_argument("--cfg", type=float, help="覆盖 cfg")
    ap.add_argument("--denoise", type=float, help="覆盖首采 denoise")
    ap.add_argument("--denoise2", type=float, help="覆盖二采 denoise")
    ap.add_argument("--scale", type=float, help="覆盖二采放大倍数")
    ap.add_argument("--latent", action="store_true",
                    help="二采回退到 latent 放大（krea2 2k 默认走像素放大，线条更好）")
    ap.add_argument("--vae-tiled", action="store_true",
                    help="分块 VAE 解码（大分辨率省显存，Qwen VAE 几乎不掉速）")
    ap.add_argument("--lora", action="append", default=[],
                    help="LoRA 名[:强度]，可重复")
    ap.add_argument("--negative", help="负面提示词（cfg>1 时生效）")
    ap.add_argument("--negative-file", help="从文件读负面提示词")
    ap.add_argument("--lora-strength", type=float, default=1.0,
                    help="未写强度时的默认 LoRA 强度")
    ap.add_argument("--edit", metavar="IMAGE", help="MOSS 参考图编辑的输入图片")
    ap.add_argument("--edit-strength", type=float, default=1.0)
    ap.add_argument("--inpaint", metavar="IMAGE",
                    help="局部细化/重绘的源图；配合 --rect 或 --mask 指定区域")
    ap.add_argument("--rect", metavar="X,Y,W,H",
                    help="重绘区域（原图像素坐标），与 --mask 互斥")
    ap.add_argument("--mask", metavar="IMAGE",
                    help="黑白 mask 图，白=重绘；与 --rect 互斥")
    ap.add_argument("--anypaint", metavar="IMAGE",
                    help="Krea2 AnyPaint 局部编辑的源图；配合 --rect/--mask "
                         "指定区域（白=重绘），构图和未覆盖像素保持不变")
    ap.add_argument("--anypaint-boundary", type=int, default=32,
                    help="AnyPaint 在 mask 边界重画的像素，默认 32")
    ap.add_argument("--anypaint-ref-edge", type=int, default=384,
                    help="AnyPaint 语义参考图长边，默认 384")
    ap.add_argument("--anypaint-sr", action="store_true",
                    help="AnyPaint 出图后接 2x 超分")
    ap.add_argument("--anypaint-sr-model",
                    default="2x-AnimeSharpV2_RPLKSR_Sharp.pth",
                    help="--anypaint-sr 使用的超分模型")
    ap.add_argument("--refine-denoise", type=float,
                    help="局部重绘 denoise；默认由 --refine-level 决定")
    ap.add_argument("--refine-level", type=int, default=1, choices=(1, 2, 3, 4),
                    help="局部重绘强度档：1 收尾 / 2 轻修 / 3 细节 / 4 重绘"
                         "（默认 1）")
    ap.add_argument("--refine-pad", type=int, default=None,
                    help="crop 时保留的上下文像素；默认由档位决定（64）")
    ap.add_argument("--refine-long-edge", type=int, default=None,
                    help="重绘区域的长边分辨率；默认由档位决定")
    ap.add_argument("--refine-feather", type=int, default=None,
                    help="贴回时的羽化像素；默认由档位决定（32）")
    ap.add_argument("--refine-shrink", type=int, default=None,
                    help="采样区域相对 --rect 内缩的像素，默认 feather/2；"
                         "0 = 不内缩（边界可能出现 VAE 亮边）")
    ap.add_argument("--no-refine-sr", action="store_true",
                    help="不用 AnimeSharp 放大 crop（默认用，线条更稳）")
    ap.add_argument("--refine-sr-model", default="2x-AnimeSharpV2_RPLKSR_Sharp.pth")
    ap.add_argument("--out", help="SaveImage 文件名前缀")
    ap.add_argument("--timeout", type=int, default=900)
    ap.add_argument("--queue-wait", type=int, default=600)
    ap.add_argument("--lock-wait", type=int, default=600)
    ap.add_argument("--no-restart", action="store_true",
                    help="内存不足时不自动重启服务，直接失败")
    ap.add_argument("--allow-risky", action="store_true",
                    help="允许未验证的高分辨率预设")
    ap.add_argument("--allow-format-mismatch", action="store_true",
                    help="模型不支持该提示词形态时仍然发送（逃生通道）")
    ap.add_argument("--dry", action="store_true", help="只打印 API graph")
    ap.add_argument("--inspect", action="append", default=[], metavar="IMAGE",
                    help="从图片元数据反解配方（只读，可重复）")
    ap.add_argument("--list", action="store_true", help="输出 JSON 能力清单")
    return ap


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv and argv[0] == "inspect":
        return do_inspect(argv[1:])

    a = build_parser().parse_args(argv)
    a.native_snapped = False
    a.requested_aspect = None

    if a.list:
        do_list()
        return 0

    if a.inspect:
        return do_inspect(a.inspect)

    if a.native and (a.edit or a.inpaint or a.anypaint):
        fail(2, "bad_args",
             "--native 只用于文生图，不能与 --edit/--inpaint/--anypaint 同用",
             "这些模式沿用参考图或源图的尺寸；去掉 --native 即可")

    prompt = a.prompt_opt or a.prompt
    if a.prompt_file:
        prompt = open(a.prompt_file, encoding="utf-8").read()
    if a.negative_file:
        a.negative = open(a.negative_file, encoding="utf-8").read()
    a.negative = (a.negative or "").strip() or None
    prompt_style = detect_prompt_style(prompt)

    if a.model not in MODELS:
        fail(2, "bad_model", f"未知模型 {a.model!r}",
             "可选：" + ", ".join(sorted(MODELS)))

    a.mcfg = resolve_variant(a)

    if (prompt_style == "tag" and not a.mcfg.get("supports_tags", True)
            and not a.allow_format_mismatch):
        fail(2, "prompt_format_unsupported",
             f"{a.model} 不支持 tag 形态的提示词（检测为 tag）",
             "改写成自然语言描述，或加 --allow-format-mismatch 强制发送")

    if not prompt or not prompt.strip():
        fail(2, "missing_prompt", "没有提示词",
             '用法：imggen "一只猫"；能力清单：imggen --list')

    if a.edit and a.model != "moss":
        fail(2, "bad_edit_model", "--edit 只有 moss 支持",
             "imggen -m moss --edit 图片路径 \"指令\"")

    if a.inpaint and a.edit:
        fail(2, "bad_args", "--inpaint 与 --edit 不能同时使用",
             "--inpaint 是局部重绘，--edit 是整图指令编辑")
    if a.anypaint:
        if a.model != "krea2":
            fail(2, "bad_anypaint_model", "--anypaint 只有 krea2 支持",
                 'imggen -m krea2 --anypaint 源图.png --rect X,Y,W,H "描述"')
        if a.edit or a.inpaint:
            fail(2, "bad_args",
                 "--anypaint 与 --edit/--inpaint 不能同时使用",
                 "--anypaint 用 AnyPaint 的 mask 约束，--inpaint 用低 denoise 重绘")
        if a.rect and a.mask:
            fail(2, "bad_args", "--rect 与 --mask 只能二选一",
                 "--rect 给矩形，--mask 给任意形状的 mask 图")
        if not a.rect and not a.mask:
            fail(2, "bad_args",
                 "--anypaint 需要 --rect 或 --mask 指定编辑区域",
                 '例：--anypaint out.png --rect 600,500,400,450 "..."')
        if a.anypaint_boundary < 0 or a.anypaint_ref_edge < 64:
            fail(2, "bad_args", "AnyPaint 参数越界",
                 "--anypaint-boundary ≥ 0，--anypaint-ref-edge ≥ 64")
    if a.inpaint:
        if a.rect and a.mask:
            fail(2, "bad_args", "--rect 与 --mask 只能二选一",
                 "--rect 给矩形，--mask 给任意形状的 mask 图")
        if not a.rect and not a.mask:
            fail(2, "bad_args", "--inpaint 需要 --rect 或 --mask 指定重绘区域",
                 '例：--inpaint out.png --rect 600,500,400,450 "..."')
        apply_refine_level(a)

    # seed
    if str(a.seed).lower() in ("random", "rand", "r"):
        a.seed = random.randrange(0, 2 ** 32)
    else:
        try:
            a.seed = int(a.seed)
        except ValueError:
            fail(2, "bad_seed", f"--seed 需要整数或 random，收到 {a.seed!r}")

    # LoRA（需要服务在线，先确保）
    if a.lora and not service_up():
        ensure_service()
    a.loras = resolve_loras(a)

    if a.anypaint:
        anypaint_src, anypaint_mask, anypaint_size = prepare_anypaint(a)
        spec = anypaint_spec(a, anypaint_size)
        preset, custom = "anypaint", True
    elif a.inpaint:
        spec = refine_spec(a)
        preset, custom = "refine", True
    else:
        spec, preset, custom = resolve_spec(a)
    if a.vae:
        spec["vae"] = a.vae

    # 参考图：复制到 ComfyUI/input 并哈希去重
    edit_name = None
    if a.edit:
        src = os.path.abspath(os.path.expanduser(a.edit))
        if not os.path.isfile(src):
            fail(2, "edit_not_found", f"参考图不存在：{src}")
        ext = os.path.splitext(src)[1].lower() or ".png"
        if ext not in (".png", ".jpg", ".jpeg", ".webp", ".bmp"):
            fail(2, "bad_edit_image", f"不支持的图片格式：{ext}")
        h = hashlib.sha1(open(src, "rb").read()).hexdigest()[:12]
        edit_name = f"imggen_edit_{h}{ext}"
        os.makedirs(INPUT_DIR, exist_ok=True)
        dst = os.path.join(INPUT_DIR, edit_name)
        if not os.path.exists(dst):
            shutil.copyfile(src, dst)

    refine_src = refine_mask = refine_sample = refine_crop = None
    refine_size = refine_shrink = None
    if a.inpaint:
        (refine_src, refine_mask, refine_sample, refine_crop,
         refine_shrink, refine_size) = prepare_refine(a)

    if not a.out:
        ts = datetime.now().strftime("%Y%m%d_%H%M%S")
        a.out = f"imggen_{a.model}_{ts}"

    if a.anypaint:
        graph = build_anypaint_graph(a, spec, prompt, anypaint_src,
                                     anypaint_mask)
    elif a.inpaint:
        graph = build_refine_graph(a, spec, prompt, refine_src, refine_mask,
                                   refine_sample, refine_crop)
    else:
        graph = build_graph(a, spec, prompt, edit_name)

    if a.dry:
        if a.anypaint:
            dry_w, dry_h = anypaint_size
        elif a.inpaint:
            dry_w, dry_h = refine_size
        else:
            dry_w, dry_h = spec["width"], spec["height"]
        dry_out_w = int(dry_w * spec.get("scale", 1))
        dry_out_h = int(dry_h * spec.get("scale", 1))
        dry_warnings = []
        if a.native_snapped:
            msg = _native_aspect_warning(a.requested_aspect,
                                         dry_out_w, dry_out_h)
            if msg:
                dry_warnings.append(msg)
        d = {"ok": True, "dry": True, "model": a.model,
             "variant": a.mcfg.get("variant"), "preset": preset,
             "prompt_style": prompt_style,
             "supports_tags": a.mcfg.get("supports_tags", True),
             "native_snapped": bool(a.native_snapped),
             "requested_aspect": a.requested_aspect,
             "actual_aspect": _aspect_label(dry_out_w, dry_out_h),
             "width": dry_w, "height": dry_h,
             "output_width": dry_out_w, "output_height": dry_out_h,
             **({"warnings": dry_warnings} if dry_warnings else {}),
             "spec": spec, "seed": a.seed, "graph": graph}
        if a.anypaint:
            d["anypaint"] = {"source": anypaint_src, "mask": anypaint_mask,
                             "boundary": a.anypaint_boundary,
                             "ref_edge": a.anypaint_ref_edge,
                             "sr": a.anypaint_sr,
                             "size": anypaint_size}
        if a.inpaint:
            lv = REFINE_LEVELS[a.refine_level]
            d["refine"] = {"level": a.refine_level, "name": lv["name"],
                           "denoise": a.refine_denoise,
                           "long_edge": a.refine_long_edge,
                           "pad": a.refine_pad, "feather": a.refine_feather,
                           "shrink": refine_shrink,
                           "source": refine_src, "mask": refine_mask,
                           "sample_mask": refine_sample,
                           "crop": refine_crop}
        emit(d)
        return 0

    # 只有真正出图才刷新空闲计时（--list / --dry / 参数错误都不算请求）
    touch_activity()

    # 串行 + 服务 + 内存
    lock = acquire_lock(a.lock_wait)
    started = restarted = False

    if not service_up():
        touch_activity()
        _, _, detail = ensure_service()
        touch_activity()
        started = True
        log(f"[imggen] 服务已拉起：{detail}")

    wait_queue_idle(a.queue_wait)

    min_gb = a.mcfg["min_avail_gb"]
    ok, why, avail, swap_used = mem_check(min_gb)
    if not ok:
        if a.no_restart:
            lock.close()
            fail(4, "low_memory", f"{why}（--no-restart，未重启）",
                 "释放内存后重试，或去掉 --no-restart 让脚本自动重启")
        log(f"[imggen] 内存不足（{why}），自动重启 ComfyUI…")
        touch_activity()
        ensure_service(force=True)
        touch_activity()
        restarted = True
        # 等内存回落，最多 90 秒
        deadline = time.time() + 90
        while time.time() < deadline:
            ok, why, avail, swap_used = mem_check(min_gb)
            if ok:
                break
            time.sleep(3)
        if not ok:
            lock.close()
            fail(4, "low_memory", f"重启后仍然内存不足：{why}",
                 "zram 活锁一般需要彻底重启机器；先 pkill ComfyUI 等内存回落")

    freed = False
    # --highvram 下 ComfyUI 不会主动卸载旧模型，换模型时必须先清空，
    # 否则旧模型(最多 7GB) + 新模型峰值会顶爆 16GB。
    state_path = os.path.join(STATE_DIR, "imggen.lastmodel")
    last_model = None
    try:
        last_model = open(state_path).read().strip() or None
    except Exception:
        pass
    switched = last_model != a.model

    def free_vram():
        try:
            http_post("/free", json.dumps(
                {"unload_models": True, "free_memory": True}).encode())
            time.sleep(2)
            return True
        except Exception:
            return False

    def vfree_gb():
        try:
            return system_stats()["vram_free"] / GB
        except Exception:
            return None

    peak = a.mcfg["vram_need_gb"]
    if switched:
        log(f"[imggen] 切换模型 {last_model or '(空)'} → {a.model}，先卸载旧模型…")
        freed = free_vram()
    vfree = vfree_gb()
    need = peak if (switched or freed) else 0.5
    if vfree is not None and vfree < need:
        log(f"[imggen] 空闲显存 {vfree:.1f}GB < 需要 {need:.1f}GB，卸载已加载模型…")
        freed = free_vram() or freed
        vfree = vfree_gb()
        need = peak
    if vfree is not None and vfree < need and not a.no_restart:
        log(f"[imggen] 仍只有 {vfree:.1f}GB，重启服务…")
        ensure_service(force=True)
        restarted = True
        time.sleep(2)
        vfree = vfree_gb()
    if vfree is not None and vfree < need:
        lock.close()
        fail(4, "low_vram",
             f"空闲显存 {vfree:.1f}GB 仍低于 {a.model} 需要的 {need:.1f}GB",
             "有其他进程占用显存（rocm-smi 查看），或等它们结束")
    try:
        os.makedirs(os.path.dirname(state_path), exist_ok=True)
        open(state_path, "w").write(a.model)
    except Exception:
        pass

    touch_activity()
    t0 = time.time()
    res = submit(graph)
    pid = res.get("prompt_id")
    if not pid:
        fail(5, "no_prompt_id", f"提交返回异常：{json.dumps(res)[:500]}")
    log(f"[imggen] 已提交 {pid}（{a.model}/{preset}，seed={a.seed}）")

    entry, _ = wait_done(pid, a.timeout)
    touch_activity()
    elapsed = round(time.time() - t0, 1)

    err = entry_error(entry)
    if err:
        kind, node_type, detail = err
        lock.close()
        fail(6, "execution_failed", f"{kind} @ {node_type}: {detail}",
             f"查看 {LOG} 尾部日志")

    paths = collect_images(entry)
    if not paths:
        lock.close()
        fail(6, "no_output", "执行完成但没有找到输出图片",
             "加 --dry 检查 SaveImage 节点")

    warnings = []
    out_w = (refine_size[0] if refine_size
             else int(spec["width"] * spec.get("scale", 1)))
    out_h = (refine_size[1] if refine_size
             else int(spec["height"] * spec.get("scale", 1)))
    if a.native_snapped:
        msg = _native_aspect_warning(a.requested_aspect, out_w, out_h)
        if msg:
            warnings.append(msg)
    # 原生档位走单采，原 preset 的耗时基准不再适用
    est = (None if a.native_snapped
           else a.mcfg["presets"].get(preset, {}).get("est_seconds"))
    # 冷启动判定：实测明显超出热态基准，或提交前显存里几乎没有模型
    cold_likely = (bool(est and elapsed > est * 1.3)
                   or (est is None and not a.native_snapped and elapsed > 20))
    if started:
        warnings.append("auto_started_service")
    if freed:
        warnings.append("unloaded_models_before_run")
    if restarted:
        warnings.append("restarted_service_for_memory")
    if cold_likely:
        warnings.append("cold_start（模型未驻留或刚换模型，本次耗时偏高）")
    if a.lora:
        warnings.append("lora_on_quantized_model（量化权重上的 LoRA 效果需目视确认）")
    if preset.startswith("custom"):
        warnings.append("custom_size_single_pass")
    if a.negative and spec["cfg"] <= 1.0:
        warnings.append("negative_ignored_cfg1（cfg=1 不跑负面分支）")
    if prompt_style == "tag" and not a.mcfg.get("supports_tags", True):
        warnings.append("format_mismatch_forced（已用逃生通道发送 tag）")

    try:
        st = system_stats()
        vram_after = round((st["vram_total"] - st["vram_free"]) / GB, 2)
    except Exception:
        vram_after = None

    emit({
        "ok": True,
        "model": a.model,
        "variant": a.mcfg.get("variant"),
        "prompt_style": prompt_style,
        "supports_tags": a.mcfg.get("supports_tags", True),
        "vae": spec.get("vae") or a.mcfg["vae"],
        "preset": preset,
        "native_snapped": bool(a.native_snapped),
        "requested_aspect": a.requested_aspect,
        "actual_aspect": _aspect_label(out_w, out_h),
        "width": refine_size[0] if refine_size else spec["width"],
        "height": refine_size[1] if refine_size else spec["height"],
        "output_width": out_w,
        "output_height": out_h,
        "steps": spec["steps"],
        "steps2": spec.get("steps2"),
        "seed": a.seed,
        "images": paths,
        "seconds": elapsed,
        "estimated_seconds_hot": est,
        "cold_likely": cold_likely,
        "restarted": restarted,
        "vram_used_gb": vram_after,
        "extra_prompt_id": pid,
        "warnings": warnings,
        **({"refine": {"region": refine_crop, "denoise": spec["denoise"],
                       "source": refine_src}} if a.inpaint else {}),
        **({"anypaint": {"source": anypaint_src, "mask": anypaint_mask,
                         "boundary": a.anypaint_boundary,
                         "ref_edge": a.anypaint_ref_edge,
                         "sr": a.anypaint_sr}} if a.anypaint else {}),
    })
    lock.close()
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        fail(6, "interrupted", "被用户中断")
    except SystemExit:
        raise
    except Exception as e:  # 兜底，保证 stdout 仍是 JSON
        import traceback
        traceback.print_exc(file=sys.stderr)
        fail(6, "internal_error", f"{type(e).__name__}: {e}")
