#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""imggen — 给 LLM / 脚本用的 ComfyUI 出图单入口。

设计目标：LLM 只需要 `imggen --list` 和 `imggen "提示词"` 两条命令，
所有加速细节（int8/int4、HIP attention、二采、VAE 选择、内存保护）都封装在这里。

  imggen --list                                   # JSON 能力清单
  imggen "提示词"                                  # 默认 moss / 1024² / 4 步
  imggen -m anima "提示词"                         # 1024→1536 二采，12 秒
  imggen -m krea2 --preset 2k "提示词"             # 1152×2048 二采，锁构图
  imggen -m krea2 --preset 2k-direct "提示词"      # 1152×2048 单采，细节更好
  imggen -m krea2 --aspect 16:9 --native "提示词"  # 吸附到模型原生档位
  imggen -m moss --size 1024 "提示词"
  imggen -m anima --width 1344 --height 768 "提示词"   # 自定义尺寸走单采
  imggen -m krea2 --lora thick:0.8 "提示词"
  imggen --edit a.png "把剑换成蓝色能量刃"          # MOSS 参考图编辑
  imggen --dry -m krea2 "x"                        # 只打印 API graph

stdout 永远只有一行 JSON；进度和日志走 stderr。
退出码：0 成功 / 2 参数错误 / 3 服务不可用 / 4 内存不足 /
        5 提交被拒（附 node_errors）/ 6 执行失败或超时。
"""

