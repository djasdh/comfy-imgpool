#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""imggen — 给 LLM / 脚本用的 ComfyUI 出图单入口。

设计目标：LLM 只需要 `imggen --list` 和 `imggen "提示词"` 两条命令，
所有加速细节（int8/int4、HIP attention、二采、VAE 选择、内存保护）都封装在这里。

  imggen --list                                   # JSON 能力清单
  imggen "提示词"                                  # 默认 moss / 1024² / 4 步
  imggen -m anima "提示词"                         # 1024→1536 二采，12 秒
  imggen -m krea2 --preset 2k "提示词"             # 1152×2048 二采，27 秒
  imggen -m moss --size 1024 "提示词"
  imggen -m anima --width 1344 --height 768 "提示词"   # 自定义尺寸走单采
  imggen -m anima --lora modern-anime-lora:0.8 "提示词"
  imggen --edit a.png "把剑换成蓝色能量刃"          # MOSS 参考图编辑
  imggen --dry -m krea2 "x"                        # 只打印 API graph

stdout 永远只有一行 JSON；进度和日志走 stderr。
退出码：0 成功 / 2 参数错误 / 3 服务不可用 / 4 内存不足 /
        5 提交被拒（附 node_errors）/ 6 执行失败或超时。
"""

import argparse
import fcntl
import hashlib
import json
import os
import random
import re
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
import uuid
from datetime import datetime

def _find_comfy_root():
    """定位 ComfyUI 项目根目录：COMFY_ROOT > 向上查找含 ComfyUI/ 的目录。"""
    env = os.environ.get("COMFY_ROOT")
    if env:
        return os.path.abspath(os.path.expanduser(env))
    here = os.path.dirname(os.path.realpath(__file__))
    for base in (os.getcwd(), here):
        d = base
        for _ in range(5):
            if os.path.isdir(os.path.join(d, "ComfyUI")):
                return d
            nd = os.path.dirname(d)
            if nd == d:
                break
            d = nd
    return os.path.dirname(here)

ROOT = _find_comfy_root()
COMFY_DIR = os.environ.get("COMFY_DIR", os.path.join(ROOT, "ComfyUI"))
OUTPUT_DIR = os.path.join(COMFY_DIR, "output")
INPUT_DIR = os.path.join(COMFY_DIR, "input")
ENSURE = os.environ.get("COMFY_ENSURE", os.path.join(ROOT, "bin", "comfy-ensure.sh"))
LOG = os.environ.get("COMFY_LOG", os.path.join(ROOT, "logs", "comfy-2k.log"))
STATE_DIR = os.environ.get("IMGPOOL_STATE_DIR", "/tmp/comfy-imgpool")
os.makedirs(STATE_DIR, exist_ok=True)
LOCK_PATH = os.path.join(STATE_DIR, "imggen.lock")
ACTIVITY_FILE = os.environ.get("IMGPOOL_ACTIVITY_FILE",
                               os.path.join(STATE_DIR, "comfy-last-activity"))
BASE = os.environ.get("COMFY_URL", "http://127.0.0.1:8188").rstrip("/")

GB = 1024 ** 3


# ----------------------------------------------------------------------------
